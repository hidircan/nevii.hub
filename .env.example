# Supabase (server-side)
# Set only on server. Do NOT commit real secret values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only service role key for secure uploads and signed URL generation
SUPABASE_SERVICE_ROLE_KEY=

# SMS (tahsilat) — server-only. Do not put real numbers, tokens, or secrets here.
# SMS_PROVIDER=twilio
# TWILIO_SMS_FROM=
# SMS_TEST_MODE=true restricts live SMS to SMS_TEST_ALLOWED_RECIPIENTS (E.164, comma-separated).
# SMS_TEST_MODE=
# SMS_TEST_ALLOWED_RECIPIENTS=
# Public HTTPS URL Twilio uses to sign inbound webhooks (scheme+host+path).
# SMS_WEBHOOK_PUBLIC_URL=
# Notification sweep cron (lesson upcoming / pending payment / leave). Fail-closed if unset.
# NOTIFICATION_CRON_SECRET=

# Expo Push (lesson reminders etc.) — server-only. Fail-closed: PUSH_ENABLED=true
# + EXPO_PUSH_ACCESS_TOKEN dolu olmadıkça gönderim YOK (`src/lib/push/config.ts`).
# PUSH_ENABLED=false
# EXPO_PUSH_ACCESS_TOKEN=

# CSRF/Origin allowlist (src/lib/api/csrf-guard.ts) — the app's own origin is always
# trusted automatically; only set this if a SEPARATE web frontend domain is added later
# (comma-separated, e.g. https://app.example.com,https://staging.example.com). Never a
# wildcard. Does not affect Bearer-token (mobile/API) callers, which are CSRF-exempt,
# or public webhook/cron routes, which use their own signature/secret auth.
# ALLOWED_WEB_ORIGINS=

# WhatsApp — server-only. Do not put real numbers, tokens, or secrets here.
# WHATSAPP_PROVIDER=meta|twilio|evolution|console
# GET verification challenge token (Meta "Verify Token"). Required in production —
# webhook verification fails closed if unset.
# WHATSAPP_VERIFY_TOKEN=
# Meta Cloud API app secret, used to verify X-Hub-Signature-256 on inbound webhooks.
# Required in production when WHATSAPP_PROVIDER=meta — webhook fails closed (503) if unset.
# WHATSAPP_META_APP_SECRET=
# Shared secret for non-Meta providers (twilio/evolution), sent as X-Webhook-Secret.
# Required in production for those providers — webhook fails closed (503) if unset.
# WHATSAPP_WEBHOOK_SECRET=

# Copy to .env.local and fill in the keys you have. Never commit a file with
# real values — .env* is gitignored.

# STORE_MODE picks the backend (src/lib/config.ts): "json" (default, file-backed,
# no DB needed), "db" (Prisma → PostgreSQL/Supabase via DATABASE_URL below — required to
# see any data seeded into a real database, e.g. scripts/seed-demo-csv-teachers.ts),
# "memory" (in-process, serverless demo). If this is unset, the app silently falls
# back to "json" and a real Postgres/MySQL seed will appear "missing" in the UI.
STORE_MODE=db
DATABASE_URL="postgresql://user:password@localhost:5432/notaplan"
# Production (Supabase): DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# AI runtime — provider chain (src/lib/ai/provider-chain.ts, config.ts)
# ---------------------------------------------------------------------------
# AI_PROVIDER=auto walks the chain below in order and skips any provider with
# a missing/blank key. A provider is never retried after an auth/key failure
# (invalid key, 401/403) — the runtime moves straight to the next one; other
# failures (rate limit, timeout, 5xx, malformed response, unsupported model)
# are also treated as fallback reasons. Heuristic is deterministic/keyless
# and always available, so it is always the final fallback.
#
#   1. Gemini      — GEMINI_API_KEY
#   2. Groq        — GROQ_API_KEY
#   3. NVIDIA NIM  — NVIDIA_NIM_API_KEY
#   4. Cerebras    — CEREBRAS_API_KEY
#   5. Heuristic   — no key needed, deterministic rule-based fallback
#
# Set AI_PROVIDER to one of: auto | gemini | groq | nvidiaNim | cerebras |
# heuristic | openai | grok | local (the last three are supported directly
# but are not part of the auto chain above).

AI_PROVIDER=auto
AI_TIMEOUT_MS=60000
AI_RETRY_COUNT=2

# 1) Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2) Groq Cloud — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-4-scout-17b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# 3) NVIDIA NIM — https://build.nvidia.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nemotron-3-ultra-550b-a55b
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# 4) Cerebras Cloud — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Supported but NOT part of the auto chain above — select explicitly with
# AI_PROVIDER=<name>, or (Cloudflare only) resolve directly via a capability's
# preferredProvider / resolveLiveProvider("cloudflareAi").
# OPENAI_API_KEY=
# XAI_API_KEY=
# LOCAL_LLM_URL=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Online ödeme sağlayıcısı (Karma Öğrenci Portalı — checkout) — server-only.
# Boş bırakılırsa provider fail-closed kalır (checkout başlatılamaz, kullanıcıya
# güvenli/açık bir "henüz yapılandırılmadı" mesajı gösterilir; sahte başarı ASLA
# üretilmez). Do NOT commit real values — bu dosya yalnızca alan adlarını listeler.
# PAYMENT_PROVIDER=iyzico
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# Sandbox: https://sandbox-api.iyzipay.com — Prod: https://api.iyzipay.com
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Webhook imza doğrulaması için ayrı bir secret (yoksa IYZICO_SECRET_KEY'e düşer)
# IYZICO_WEBHOOK_SECRET=

# SaaS abonelik tahsilatı (kurum→NeviiHub) — server-only.
# YENİ aboneliklerin varsayılan sağlayıcısı (eskiler kendi sağlayıcısında kalır).
# Boş bırakılırsa otomatik: PayTR yapılandırılmışsa paytr, yoksa iyzico, yoksa kapalı.
# SAAS_BILLING_PROVIDER=paytr  (paytr | iyzico | mock)
# SAAS_BILLING_PROVIDER=
# PayTR merchant (Bildirim URL + durum sorgu bu bilgilerle imzalanır)
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# Test modu: "1" test (varsayılan, fail-safe), "0" canlı (ayrı owner onayı gerekir)
# PAYTR_TEST_MODE=1
# Hesap yetkileri — PayTR onayı ALINDIKTAN sonra owner "true" yapar:
# PAYTR_CAP_DIRECT=false
# PAYTR_CAP_CARD_STORAGE=false
# PAYTR_CAP_NON3D=false
# Tahsilat job sırrı (Vercel Cron $CRON_SECRET'i de kabul eder)
# BILLING_CRON_SECRET=
# Canlı-tahsilat kilidi: GERÇEK para hareketi için "true" + Vercel production
# ortamı gerekir (ayrı owner onayı). Yoksa/yanlışsa sandbox dışı çekim kilitli.
# SAAS_BILLING_LIVE_CHARGES=false
# Abonelik webhook imzası için merchant ID (zorunlu — imza formülünün parçası)
# IYZICO_MERCHANT_ID=
# planKey:periyot → iyzico pricingPlanReferenceCode eşlemesi (panelden alınır)
# IYZICO_SUBSCRIPTION_PLAN_REFS=starter:monthly=REF1,starter:yearly=REF2,core:monthly=REF3
# NeviiAds aktarımı varsayılan KAPALI — açmak için true + dar kapsamlı jeton
# NEVIIADS_IMPORT_ENABLED=false
# NEVIIADS_IMPORT_TOKEN=
# SaaS e-postaları test koruması: true olmadan yalnız izin listesine gönderilir
# SAAS_EMAIL_LIVE=false
# SAAS_EMAIL_ALLOWLIST=ornek@sirket.com

# E-posta gönderimi (hesap daveti / "Şifrenizi Oluşturun" linki, src/lib/email/*).
# Boş bırakılırsa "console" sağlayıcısına düşülür — e-posta LOGLANIR, gönderim
# ASLA sahte başarı olarak işaretlenmez (bkz. docs/launch/ADMIN_WEB_PRODUCTION_READINESS.md).
# Cloudflare gelen posta yönlendirmesi (ör. info@ → Gmail) giden SMTP DEĞİLDİR.
# Gerçek sıfırlama postası için EMAIL_PROVIDER=smtp ve aşağıdaki anahtarlar gerekir.
# Değerleri bu dosyaya yazmayın; Vercel test ortamında Secret olarak girin.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=no-reply@example.com
# EMAIL_FROM_NAME=Nevii Hub

# Davet/aktivasyon linklerinin oluşturulduğu temel URL (prod'da MUTLAKA set edilmeli).
# APP_BASE_URL=https://panel.example.com

# ---------------------------------------------------------------------------
# PostgreSQL / Prisma (Supabase)
# ---------------------------------------------------------------------------
# DATABASE_URL — runtime connection. Use the TRANSACTION-mode pooler (port
# 6543) with pgbouncer=true; serverless functions need it.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
#
# DIRECT_URL — used ONLY by `prisma migrate` (deploy/status/dev). It must NOT
# be the transaction pooler: Prisma's migration engine needs session-level
# features (advisory locks, prepared statements) that PgBouncer's transaction
# mode does not support, and `migrate status`/`migrate deploy` then HANG with
# no error (verified 2026-09-05, see docs/agent-memory/LESSONS_LEARNED.md).
# Use the SESSION-mode pooler on port 5432 (same host/credentials, IPv4-safe),
# or the direct host db.<ref>.supabase.co:5432 if the network has IPv6.
# DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30"
