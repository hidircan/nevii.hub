# =============================================================================
# NEVII HUB — TEST ORTAMI ENV ŞABLONU (test.neviihub.com / neviihub-test)
# =============================================================================
# SECRET İÇERMEZ. Bu dosya yalnızca DEĞİŞKEN İSİMLERİNİ belgeler. Gerçek
# değerler `.env.test` / `.env.local` (gitignore'lu) veya Vercel "Preview"
# environment'ına girilir — ASLA bu dosyaya değil.
#
# Buradaki her isim `src/` veya `scripts/` altında gerçekten kullanılıyor
# (kaynak: `grep -rhoE "process\.env\.[A-Z0-9_]+" src scripts`). Kullanılmayan
# değişken bilerek eklenmemiştir.
#
# Kontrol: npm run preflight:test-env
# =============================================================================

# --- Ortam kimliği ----------------------------------------------------------
# VERCEL_ENV Vercel tarafından otomatik set edilir; test deployment'ında
# "preview" olmalıdır. "production" olursa demo seed'ler fail-closed durur.
NODE_ENV=
VERCEL_ENV=

# --- Store / veritabanı -----------------------------------------------------
# Test ortamı GERÇEK veritabanı kullanır → STORE_MODE=db ZORUNLU.
# (Boş bırakılırsa kod sessizce "json"a düşer ve Supabase boş kalır —
#  production'da bugün tam olarak bu oldu, bkz. docs/PRODUCTION_DATABASE_SOURCE_OF_TRUTH.md)
STORE_MODE=db
# neviihub-test projesinin TRANSACTION pooler'ı (port 6543, pgbouncer=true).
# Runtime bunu kullanır. Değeri buraya YAZMAYIN.
DATABASE_URL=
# YALNIZ BELGE AMAÇLI: bu repoda `prisma.config.ts` DIRECT_URL'i OKUMAZ,
# sadece DATABASE_URL'i okur. Migration çalıştırırken DATABASE_URL'i SESSION
# pooler'ı (port 5432) ile satır içi override edin — bkz. docs/TEST_SUPABASE_RUNBOOK.md.
DIRECT_URL=
# Yalnız Prisma CLI'ın provider seçimi için; şema postgresql sabitli.
DATABASE_PROVIDER=postgresql

# --- Supabase (Storage) -----------------------------------------------------
# Uygulama Supabase AUTH kullanmaz (kendi JWT/cookie katmanı var). Yalnız
# Storage için gerekli: 'announcement-attachments' adlı PRIVATE bucket.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Kimlik / oturum --------------------------------------------------------
# Test için PRODUCTION JWT_SECRET'İ ASLA KULLANMAYIN — ayrı bir değer üretin.
JWT_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=
DEFAULT_TENANT_ID=
PII_ENCRYPTION_KEY=

# --- Uygulama URL'i ---------------------------------------------------------
# Test ortamında https://test.neviihub.com olmalı. Production URL'i buraya
# yazılırsa davet/şifre linkleri production'a gider (preflight uyarır).
APP_BASE_URL=
NEXT_PUBLIC_APP_BASE_URL=
ALLOWED_WEB_ORIGINS=
MOBILE_APP_SCHEME=
APP_STORE_URL=
PLAY_STORE_URL=

# --- Demo/test kullanıcı parolaları (yalnız test/demo hesapları) ------------
AUTH_SUPER_PASSWORD=
AUTH_OWNER_PASSWORD=
AUTH_MANAGER_PASSWORD=
AUTH_ADMIN_PASSWORD=
AUTH_TEST_ADMIN_PASSWORD=
AUTH_PARENT_PASSWORD=
AUTH_STUDENT_PASSWORD=
AUTH_AGENT_PASSWORD=

# --- AI sağlayıcı zinciri ---------------------------------------------------
# Boş bırakılırsa keyless "heuristic" fallback'e düşer — test için GÜVENLİ
# varsayılan (gerçek sağlayıcıya istek gitmez, uydurma başarı üretilmez).
AI_PROVIDER=
AI_MODEL=
AI_TIMEOUT_MS=
AI_RETRY_COUNT=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_BASE_URL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=
GROK_API_KEY=
GROK_MODEL=
GOOGLE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=
LOCAL_LLM_URL=
LOCAL_LLM_KEY=
LOCAL_LLM_MODEL=
PLANNER_MAX_STEPS=
PLANNER_MAX_RETRIES=
AGENT_LOG_DEBUG=
AUDIT_LOG_DEBUG=

# --- AI hafıza / vektör -----------------------------------------------------
# Varsayılan "file". pgvector'a geçilecekse test DB'de `vector` extension
# kurulmalı (npm run verify:test-schema kontrol eder).
VECTOR_BACKEND=
PGVECTOR_URL=
MEMORY_TOP_K=
MEMORY_MIN_SCORE=
EMBEDDING_PROVIDER=
EMBEDDING_DIMS=
OPENAI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_MODEL=
LOCAL_EMBEDDING_URL=
LOCAL_EMBEDDING_KEY=
LOCAL_EMBEDDING_MODEL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# --- E-posta (SMTP) ---------------------------------------------------------
# EMAIL_PROVIDER boş → "console" sağlayıcısı: e-posta LOGLANIR, GÖNDERİLMEZ.
# Test ortamı için GÜVENLİ varsayılan budur. Production SMTP kimlik
# bilgilerini test ortamına ASLA yazmayın.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=
EMAIL_FROM_NAME=

# --- SMS (Twilio) -----------------------------------------------------------
# SMS_TEST_MODE=true, canlı gönderimi SMS_TEST_ALLOWED_RECIPIENTS ile sınırlar.
SMS_PROVIDER=
SMS_TEST_MODE=
SMS_TEST_ALLOWED_RECIPIENTS=
SMS_WEBHOOK_PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- WhatsApp ---------------------------------------------------------------
# WHATSAPP_PROVIDER=console → gerçek mesaj gitmez. Production webhook
# token'larını test ortamına ASLA yazmayın (aynı numarayı paylaşırlar).
WHATSAPP_PROVIDER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=
WHATSAPP_PHONE_MAP=
META_WA_TOKEN=
META_WA_APP_SECRET=
META_WA_PHONE_NUMBER_ID=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
COMMUNICATION_WEBHOOK_SECRET=

# --- Ödeme ------------------------------------------------------------------
# Boş → provider fail-closed (checkout başlatılamaz, sahte başarı ÜRETİLMEZ).
# Test ortamında yalnız SANDBOX anahtarları; production anahtarı ASLA.
PAYMENT_PROVIDER=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
IYZICO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cron / zamanlanmış işler ----------------------------------------------
# Boş bırakılırsa ilgili cron endpoint'leri fail-closed olur.
NOTIFICATION_CRON_SECRET=
TASK_REMINDER_CRON_SECRET=
TEACHER_CONTRACT_REMINDER_CRON_SECRET=

# --- Guard override (opsiyonel) ---------------------------------------------
# scripts/preflight-* guard'ları varsayılan olarak bilinen ref'leri kullanır;
# başka bir Supabase hesabında çalışılacaksa burada override edilir.
TEST_SUPABASE_REF=
PROD_SUPABASE_REF=

# --- Zaman dilimi -----------------------------------------------------------
TZ=
