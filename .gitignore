# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the checked-in templates — no secrets, they document var NAMES only
!.env.example
!.env.test.example

# local demo data store
/data

# şifrelenmiş yerel yedekler — asla commit edilmez (bkz. docs/project-brain)
.private-backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local AI/tooling artifacts — proje skill'leri (.claude/skills) repoda izlenir:
# worktree'ler, diğer makineler ve web oturumları aynı yönlendirmeyi görür.
.agents/
.claude/*
!.claude/skills/
.claude/skills/supabase*/
dev.db
skills-lock.json



# Local generated reports and design artifacts
.local-artifacts/

# Uygulama dışı içerik (reklam/tanıtım/pazarlama materyalleri) repo'ya eklenmez —
# repo dışında tutulur (bkz. docs/agent-memory/LESSONS_LEARNED.md 2026-09-28).
reklam-paketi/
pazarlama/
