{
  // NeviiHub zamanlayıcısı — Cloudflare Workers ÜCRETSİZ planı (Cron Trigger; hesap başına 5 tetik sınırı, burada 4).
  // Yalnız vercel.json "crons" ile AYNI uçları çağırır; uygulamaya veya veritabanına başka hiçbir erişimi yoktur.
  // Kurulum ve devreye alma sırası: README.md (Vercel'deki aynı cron'lar kaldırılmadan iki zamanlayıcı birden çalıştırmayın).
  "name": "neviihub-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "triggers": {
    "crons": ["*/10 4-18 * * *", "0 6 * * *", "30 0 * * *", "0 1 * * *"]
  },
  "vars": { "APP_ORIGIN": "https://neviihub.com" }
  // Gizli: `npx wrangler secret put CRON_SECRET` (Vercel'deki CRON_SECRET ile aynı değer).
}
