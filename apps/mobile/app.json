{
  "expo": {
    "name": "Nevii Hub",
    "slug": "nevii-hub-mobile",
    "scheme": "neviihub",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neviihub.mobile"
    },
    "android": {
      "package": "com.neviihub.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçebilmek için fotoğraf galerinize erişim izni gerekiyor.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
