{
  "name": "nevii-hub-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:mobile-ios-bundle": "expo export --platform ios --source-maps --output-dir /tmp/neviihub-mobile-ios-export",
    "verify:mobile-android-bundle": "expo export --platform android --source-maps --output-dir /tmp/neviihub-mobile-android-export",
    "verify:mobile-bundle": "npm run verify:mobile-ios-bundle && npm run verify:mobile-android-bundle"
  },
  "dependencies": {
    "@expo-google-fonts/gloock": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.23",
    "expo-asset": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "react-refresh": "^0.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "26.3.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
