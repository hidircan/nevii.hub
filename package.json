{
  "name": "nevii-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npx prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "db:push": "npx prisma db push",
    "preflight:test-env": "npx tsx scripts/preflight-test-env.ts",
    "preflight:test-db": "npx tsx scripts/verify-test-database-target.ts",
    "preflight:test-migration": "npx tsx scripts/preflight-test-migration.ts",
    "preflight:test-seed": "npx tsx scripts/preflight-test-seed.ts",
    "verify:test-schema": "npx tsx scripts/verify-test-schema.ts",
    "validate:mobile-review-env": "npx tsx scripts/release/validate-mobile-review-env.ts",
    "test:release": "npx tsx --test scripts/release/*.test.ts",
    "verify:mobile-bundle": "npm --prefix apps/mobile run verify:mobile-bundle",
    "seed:demo-schedule": "npx tsx scripts/seed-demo-schedule.ts",
    "seed:attendance-demo": "npx tsx scripts/seed-attendance-demo.ts",
    "seed:makeup-demo": "npx tsx scripts/seed-makeup-demo.ts",
    "backfill:display-ids": "npx tsx scripts/backfill-display-ids.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:durability": "npx tsx scripts/verify-data-durability.ts",
    "ops:dashboard-default-branch": "npx tsx scripts/set-dashboard-default-branch.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.4",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.2",
    "next": "^16.3.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
