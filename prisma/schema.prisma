generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Top-level multi-tenant boundary
model Tenant {
  id                          String                       @id @default(cuid())
  name                        String
  slug                        String                       @unique
  active                      Boolean                      @default(true)
  /// NeviiOS paket anahtarı: starter | core | pro | scale | enterprise (legacy: standard | professional)
  planKey                     String                       @default("standard")
  /// draft | provisioning | active | suspended | archived
  lifecycle                   String                       @default("active")
  shortName                   String                       @default("")
  contactEmail                String                       @default("")
  phone                       String                       @default("")
  country                     String                       @default("TR")
  timezone                    String                       @default("Europe/Istanbul")
  currency                    String                       @default("TRY")
  language                    String                       @default("tr")
  colorPrimary                String                       @default("#6d28d9")
  logoUrl                     String                       @default("")
  provisionError              String?
  idempotencyKey              String?                      @unique
  /// Wizard taslağı (şube/owner/feature seçimleri) — provision öncesi.
  draftJson                   Json?
  users                       User[]
  schools                     School[]
  branches                    Branch[]
  teachers                    Teacher[]
  students                    Student[]
  rooms                       Room[]
  lessons                     Lesson[]
  lessonSeries                LessonSeries[]
  attendances                 Attendance[]
  makeupRequests              MakeupRequest[]
  payments                    Payment[]
  studentPortalAccess         StudentPortalAccess[]
  emailTemplates              EmailTemplate[]
  recruitmentJobs             RecruitmentJob[]
  recruitmentApplications     RecruitmentApplication[]
  recruitmentEmailTemplates   RecruitmentEmailTemplate[]
  recruitmentSettings         RecruitmentSettings?
  paymentCheckoutAttempts     PaymentCheckoutAttempt[]
  followUpCases               PaymentFollowUpCase[]
  communicationMessages       CommunicationMessage[]
  teacherFeeRules             TeacherFeeRule[]
  teacherPayouts              TeacherPayout[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  announcements               Announcement[]
  panelNotes                  PanelNote[]
  trialApplications           TrialApplication[]
  clubs                       Club[]
  clubMemberships             ClubMembership[]
  clubApplications            ClubApplication[]
  lessonAssessments           LessonAssessment[]
  periodicAssessments         PeriodicAssessment[]
  teacherAvailabilityRequests TeacherAvailabilityRequest[]
  homeworks                   Homework[]
  homeworkSubmissions         HomeworkSubmission[]
  teachingMaterials           TeachingMaterial[]
  teacherFeedbacks            TeacherFeedback[]
  studentFeedbacks            StudentFeedback[]
  studentCurriculumTopics     StudentCurriculumTopic[]
  socialMediaConsents         SocialMediaConsent[]
  consentTextVersions         ConsentTextVersion[]
  kvkkConsents                KvkkConsent[]
  callLogs                    CallLog[]
  messageLogs                 MessageLog[]
  packages                    Package[]
  teacherPayoutPolicies       TeacherPayoutPolicyPeriod[]
  teacherPayoutExclusions     TeacherPayoutExclusion[]
  discountCampaigns           DiscountCampaign[]
  instrumentCatalogEntries    InstrumentCatalogEntry[]
  staffMembers                StaffMember[]
  staffAdvances               StaffAdvance[]
  payrollRecords              PayrollRecord[]
  leaveRequests               LeaveRequest[]
  expenseRecords              ExpenseRecord[]
  recurringExpenseRules       RecurringExpenseRule[]
  budgets                     Budget[]
  closedDays                  ClosedDay[]
  trialLessons                TrialLesson[]
  documentTemplates           DocumentTemplate[]
  documentInstances           DocumentInstance[]
  studentContracts            StudentContract[]
  tasks                       Task[]
  taskReminderLogs            TaskReminderLog[]
  lessonHomeworkReminderLogs  LessonHomeworkReminderLog[]
  studentAttendanceRiskLogs   StudentAttendanceRiskLog[]
  taskReminderPreferences     TaskReminderPreference[]
  studentListViews            StudentListView[]
  profilePhotos               ProfilePhoto[]
  passwordResetTokens         PasswordResetToken[]
  emailChangeTokens           EmailChangeToken[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
}

/// Auth identity — passwordHash is Argon2/bcrypt; never store plaintext
model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  role         String
  teacherId    String?
  /// DEPRECATED — Karma Öğrenci Portalı öncesi tekil öğrenci bağlantısı.
  /// Geriye dönük uyumluluk/migration kaynağı olarak korunuyor; yeni
  /// authorization kodu bunu OKUMAZ (bkz. StudentPortalAccess).
  studentId    String?
  active       Boolean  @default(true)
  /// NeviiOS: görünen ad (davet kabulünde dolar).
  displayName  String?
  /// NeviiOS soft delete — kayıt ve ilişkileri korunur, giriş/oturum kesilir.
  deletedAt    DateTime?
  /// NeviiOS: son başarılı giriş (güvenilir kaynak: authenticateUser).
  lastLoginAt  DateTime?
  /// NeviiOS: bu andan önce üretilmiş tüm token'lar geçersiz (pasifleştirme, şifre değişimi).
  sessionsRevokedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
}

/// Karma Öğrenci Portalı — bir kullanıcının hangi öğrenci(ler)e, hangi
/// erişim türüyle bağlı olduğu. Bir kullanıcı birden fazla öğrenciye
/// (GUARDIAN — birden çok çocuk) bağlı olabilir; bir öğrenci birden fazla
/// kullanıcıya bağlı olabilir (ör. iki veli). `NotificationPreference` ile
/// AYNI stil (bkz. o modelin yorumu).
model StudentPortalAccess {
  id          String    @id
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  studentId   String
  /// "GUARDIAN" | "SELF"
  accessType  String
  /// "invited" (davet gönderildi, şifre henüz belirlenmedi/ilk giriş yapılmadı)
  /// | "active" | "revoked" (admin tarafından iptal edildi — sonraki request'te etkisiz)
  status      String    @default("invited")
  invitedBy   String?
  invitedAt   DateTime  @default(now())
  activatedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, userId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, userId])
}

/// 10. tur iş #2 — kurum bazlı işlem-e-postası şablonları (davet + şifre
/// sıfırlama). Yayınlanmış (published) satır varsayılan kod-içi şablonun
/// (bkz. src/lib/email-templates/defaults.ts) yerine kullanılır; taslak
/// (draft) yalnızca önizleme/test-e-postasında görülür; eski sürümler
/// (archived) geçmiş için saklanır. Varsayılana dönüş = tüm özel satırları
/// arşivlemek (satır SİLİNMEZ, geçmiş korunur).
model EmailTemplate {
  id            String   @id
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// student_invite | parent_invite | teacher_invite | staff_invite | password_reset
  key           String
  /// "tr" | "en" (davetler bugün yalnız tr; password_reset tr+en)
  locale        String   @default("tr")
  /// draft | published | archived
  status        String   @default("draft")
  version       Int      @default(1)
  subject       String
  preheader     String   @default("")
  introHtml     String
  bodyHtml      String
  signatureHtml String   @default("")
  ctaLabel      String   @default("")
  showLogo      Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, key, locale, version])
  @@index([tenantId, key, locale, status])
}

/// İK / işe alım — iş ilanı. Herkese açık kariyer sayfasında yalnız `published` görünür.
model RecruitmentJob {
  id             String                   @id
  tenantId       String
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Kurum içinde tekil URL parçası (örn. "piyano-ogretmeni")
  slug           String
  title          String
  /// teacher | staff
  category       String                   @default("teacher")
  instruments    String[]                 @default([])
  branchId       String?
  /// full_time | part_time | freelance | intern
  employmentType String                   @default("part_time")
  location       String                   @default("")
  summary        String                   @default("")
  description    String                   @default("")
  requirements   String                   @default("")
  benefits       String                   @default("")
  /// draft | published | closed | archived
  status         String                   @default("draft")
  publishedAt    DateTime?
  closesAt       DateTime?
  createdBy      String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  applications   RecruitmentApplication[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

/// İK — aday başvurusu (aday + başvuru tek satır). Filtrelenen alanlar kolon; geri kalanı `profile` JSON.
model RecruitmentApplication {
  id                      String                   @id
  tenantId                String
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Kurum içi sıra no (IK-000001)
  seq                     Int
  jobId                   String?
  job                     RecruitmentJob?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// teacher | staff
  category                String                   @default("teacher")
  /// new | screening | interview | demo_lesson | offer | hired | rejected | withdrawn | talent_pool
  stage                   String                   @default("new")
  firstName               String
  lastName                String
  email                   String
  phone                   String                   @default("")
  city                    String                   @default("")
  instruments             String[]                 @default([])
  experienceYears         Int?
  teachingYears           Int?
  /// none | high_school | associate | bachelor | master | doctorate | conservatory
  educationLevel          String                   @default("")
  /// linkedin | kariyer_net | website | referral | instagram | other
  source                  String                   @default("website")
  tags                    String[]                 @default([])
  ratingAvg               Float?
  /// Geniş profil: okul, bölüm, beceriler, diller, müsaitlik, bağlantılar, ön yazı, UTM, CV ayrıştırma özeti…
  profile                 Json?
  cvFileId                String?
  kvkkConsentAt           DateTime?
  kvkkTextVersion         String                   @default("")
  retentionUntil          DateTime?
  anonymizedAt            DateTime?
  hiredTeacherId          String?
  hiredStaffId            String?
  lastStageChangeAt       DateTime                 @default(now())
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  files                   RecruitmentFile[]
  activities              RecruitmentActivity[]
  interviews              RecruitmentInterview[]
  evaluations             RecruitmentEvaluation[]

  @@unique([tenantId, seq])
  @@index([tenantId, stage])
  @@index([tenantId, jobId])
  @@index([tenantId, email])
}

/// İK — CV dosyası (baytlar DB'de; ek bucket gerektirmez). Anonimleştirmede silinir.
model RecruitmentFile {
  id            String                 @id
  tenantId      String
  applicationId String?
  application   RecruitmentApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  sizeBytes     Int
  data          Bytes
  createdAt     DateTime               @default(now())

  @@index([tenantId, applicationId])
}

/// İK — aday zaman çizelgesi (not, aşama, e-posta, görüşme, değerlendirme, sistem).
model RecruitmentActivity {
  id            String                 @id
  tenantId      String
  applicationId String
  application   RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// note | stage_change | email | interview | evaluation | system
  type          String
  body          String                 @default("")
  meta          Json?
  actorUserId   String?
  actorName     String                 @default("")
  createdAt     DateTime               @default(now())

  @@index([tenantId, applicationId, createdAt])
}

/// İK — görüşme / deneme dersi planı.
model RecruitmentInterview {
  id                String                 @id
  tenantId          String
  applicationId     String
  application       RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// interview | demo_lesson | phone | online
  kind              String                 @default("interview")
  scheduledAt       DateTime
  durationMinutes   Int                    @default(30)
  location          String                 @default("")
  interviewers      String                 @default("")
  /// planned | completed | cancelled | no_show
  status            String                 @default("planned")
  notes             String                 @default("")
  invitationSentAt  DateTime?
  createdBy         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([tenantId, scheduledAt])
  @@index([tenantId, applicationId])
}

/// İK — değerlendirme puan kartı.
model RecruitmentEvaluation {
  id             String                 @id
  tenantId       String
  applicationId  String
  application    RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewId    String?
  evaluatorId    String?
  evaluatorName  String                 @default("")
  /// { kriterAnahtari: 1..5 }
  scores         Json
  overall        Float
  /// strong_yes | yes | neutral | no | strong_no
  recommendation String                 @default("neutral")
  comment        String                 @default("")
  createdAt      DateTime               @default(now())

  @@index([tenantId, applicationId])
}

/// İK — kurum e-posta şablonları (alındı / olumlu / olumsuz / görüşme daveti / özel).
model RecruitmentEmailTemplate {
  id        String   @id
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// received | positive | negative | interview_invite | offer | custom
  kind      String   @default("custom")
  name      String
  subject   String
  body      String
  active    Boolean  @default(true)
  /// Sistem varsayılanından türetildiyse anahtar (örn. "received")
  systemKey String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, kind])
}

/// İK — kurum ayarları (tek satır / kurum).
model RecruitmentSettings {
  tenantId              String   @id
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  careerPageEnabled     Boolean  @default(false)
  careerPageIntro       String   @default("")
  kvkkText              String   @default("")
  kvkkTextVersion       String   @default("v1")
  notifyInApp           Boolean  @default(true)
  notifyEmails          String[] @default([])
  autoAcknowledge       Boolean  @default(true)
  retentionMonths       Int      @default(12)
  /// [{ key, label }]
  scorecardCriteria     Json?
  updatedBy             String?
  updatedAt             DateTime @updatedAt
}

/// Öğrenci/öğretmen/kullanıcı profil fotoğrafı — DocumentInstance ile AYNI mevcut
/// mimari (base64 gövde DB satırında; bu proje hiçbir blob/S3 depolamasına bağlı
/// değil, ayrı bir dış bağımlılık eklenmez). Ana Student/Teacher tablolarına
/// GÖMÜLMEZ (liste sorgularının her satırda büyük bir base64 gövde taşımaması
/// için). "user" ownerType, Student/Teacher gibi ayrı bir domain kaydı olmayan
/// roller (veli, admin) için kendi User.id'sine bağlı hesap fotoğrafıdır.
model ProfilePhoto {
  id           String   @id
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "student" | "teacher" | "user"
  ownerType    String
  ownerId      String
  fileMimeType String
  fileData     String
  fileSize     Int
  uploadedBy   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, ownerType, ownerId])
  @@index([tenantId, ownerType, ownerId])
}

/// Şifremi unuttum akışı — tek kullanımlık sıfırlama kodu. Ham kod ASLA
/// saklanmaz, yalnızca sha256 hash'i (`tokenHash`). `usedAt` set edilince
/// (bkz. consumePasswordResetToken) kod bir daha kullanılamaz.
model PasswordResetToken {
  id        String    @id
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String
  expiresAt DateTime
  /// NeviiOS — yönetici başlatmalı sıfırlamada başlatan kullanıcı; kendi talebinde (şifremi unuttum) null.
  createdBy String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

/// E-posta değiştirme doğrulama token'ları (2026-09-11) — yeni adres
/// bağlama amacı ayrı olduğu için ayrı tablo (şifre sıfırlama token'larıyla
/// KARIŞMAZ). BU MİGRATION HİÇBİR VERİTABANINA UYGULANMADI.
model EmailChangeToken {
  id        String    @id
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  newEmail  String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model School {
  id                     String           @id @default(cuid())
  tenantId               String
  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String
  shortName              String
  city                   String
  website                String
  email                  String
  phone                  String
  logoUrl                String
  makeupWindowDays       Int
  /// Aylık öğrenci başına telafi hakkı (varsayılan 2). 0 = telafi kapalı.
  monthlyMakeupAllowance Int              @default(2)
  lessonDurationMinutes  Int
  workingHoursStart      String
  workingHoursEnd        String
  workingDays            Json
  currency               String
  /// EPIC 3 (IMPLEMENTATION_PLAN.md): "exact_minutes" | "round_30" | "fixed_package" —
  /// how a lesson's actual duration is converted to payable minutes in
  /// computeTeacherEarningsForPeriod (src/lib/teacher-payout.ts). Never
  /// changes a TeacherPayout snapshot already generated — only affects
  /// future computations.
  feeRoundingMode        String           @default("exact_minutes")
  /// EPIC 1 (IMPLEMENTATION_PLAN.md) — gecikmiş tahsilat otomasyon ayarları:
  /// { frequencyLimitDays: number; autoSendEnabled: boolean }. null ise
  /// uygulama katmanı varsayılanları (3 gün, autoSendEnabled: false) uygular.
  collectionsSettings    Json?
  /// Paket 6 — dönem bazlı haftalık kapalı gün özelleştirmesi:
  /// { guz: number[]; yaz: number[] } (0=Pazar..6=Cumartesi). null ise
  /// src/lib/attendance-calendar.ts'teki sabit varsayılanlar kullanılır.
  termWeeklyClosedDays   Json?
  /// Faz 8 (KVKK) — { restrictedFeatures: string[]; recordDeviceInfo: boolean }. null ise
  /// uygulama katmanı varsayılanları (boş kısıtlı-özellik listesi, recordDeviceInfo: false —
  /// "veri minimizasyonu") uygular.
  consentSettings        Json?
  /// Kurum sahibi performans ağırlıkları. null = ürün varsayılanı.
  /// Şema: src/lib/performance-weights.ts
  performanceWeights     Json?
  /// Kritik işlem (öğrenci silme vb.) şifresinin bcrypt hash'i — plaintext ASLA
  /// saklanmaz, AppData/settings'e MAP EDİLMEZ (istemciye sızmaz). Bkz. critical-action-password.ts.
  criticalActionPasswordHash  String?
  criticalActionPasswordSetAt DateTime?
  criticalActionPasswordSetBy String?
  branches               Branch[]
  teachers               Teacher[]
  students               Student[]
  rooms                  Room[]
  lessons                Lesson[]
  lessonSeries           LessonSeries[]
  attendances            Attendance[]
  makeupRequests         MakeupRequest[]
  payments               Payment[]
  teacherFeeRules        TeacherFeeRule[]
  teacherPayouts         TeacherPayout[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([tenantId])
  @@index([tenantId])
}

model Branch {
  id              String           @id
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId        String
  name            String
  shortName       String
  address         String
  phone           String
  city            String
  teachers        Teacher[]
  students        Student[]
  rooms           Room[]
  lessons         Lesson[]
  lessonSeries    LessonSeries[]
  makeupRequests  MakeupRequest[]
  teacherFeeRules TeacherFeeRule[]

  @@index([tenantId])
  @@index([schoolId])
}

model Teacher {
  id                    String           @id
  tenantId              String
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Faz 12 — insan-okunur, değişmez kurum numarası (ör. "T00001").
  displayId             String?
  name                  String
  email                 String
  phone                 String
  branch                Branch           @relation(fields: [branchId], references: [id])
  branchId              String
  school                School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId              String
  instruments           Json
  /// ÖNCELİK 4 (devam) — çoklu enstrüman + seviye çiftleri: [{instrument, level}].
  /// NULL = legacy kayıt (bu alan eklenmeden önce oluşturuldu); UI bu durumda
  /// yalnızca `instruments`'ı (seviyesiz) gösterir, hata vermez.
  instrumentLevels      Json?
  availability          Json
  maxDailyLessons       Int
  active                Boolean
  /// ÖNCELİK 4 (devam) — öğretmen arşivleme (hard delete YOK). NULL = aktif
  /// veya legacy kayıt; set edilmişse arşivlenme anı. `active=false` ile
  /// birlikte kullanılır — bkz. src/lib/services/tools.ts archiveTeacherTool.
  archivedAt            DateTime?
  /// 2026-10-03 — "listeden kaldırma" (geri alınabilir silme): satır kalır ki geçmiş ders/yoklama/
  /// hakediş ve raporlar öğretmen adını göstermeye devam etsin. Yalnız pasif öğretmende set edilir.
  deletedAt             DateTime?
  deletedByUserId       String?
  deletionReason        String?
  /// ÖNCELİK 4 (devam) — öğretmen CSV çoklu enstrüman revizyonu: bu 5 alan
  /// TS tipinde (Teacher) zaten vardı ama hiçbir zaman DB'de karşılığı yoktu
  /// (db modunda hep sessizce kayboluyordu) — CSV'nin `lise/universite/
  /// mezuniyet/sozlesme_baslangic/sozlesme_bitis` kolonlarını db modunda da
  /// kalıcı kılmak için burada eklendi.
  highSchool            String?
  university            String?
  graduationYear        Int?
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  /// Package D — özlük/idari alanlar + çoklu şube ataması. Additive; hepsi
  /// opsiyonel, legacy kayıtlar kırılmaz. `nationalIdCipher`/`birthDate`/
  /// `address` TS tipinde (Teacher) zaten vardı ama hiçbir zaman DB'de
  /// karşılığı yoktu (db modunda hep sessizce kayboluyordu) — burada eklendi.
  nationalIdCipher      String?          @db.Text
  nationalIdLast2       String?
  birthDate             DateTime?
  address               String?
  /// Öğretmenin fiilen ders verdiği EK şubeler (birincil `branchId` her
  /// zaman dahil sayılır, burada tekrar listelenmesi gerekmez).
  branchIds             Json?
  /// "tam_zamanli" | "yari_zamanli" | "serbest"
  employmentType        String?
  hireDate              DateTime?
  /// Set edilmişse hireDate'ten önce olamaz (validation.ts).
  terminationDate       DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  personnelNotes        String?          @db.Text
  /// Haftalık ders saati eşiği — üstü nakit, altı havale varsayılanı.
  weeklyHoursThreshold  Int?
  /// Öğretmen kaydını açan kullanıcı (User.id). Eski kayıtlarda null.
  createdByUserId       String?
  color                 String
  students              Student[]
  lessons               Lesson[]
  lessonSeries          LessonSeries[]
  makeupRequests        MakeupRequest[]
  teacherFeeRules       TeacherFeeRule[]
  teacherPayouts        TeacherPayout[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([schoolId])
}

/// Faz 12 — tenant-kapsamlı, çarpışmasız, insan-okunur numara sayacı.
/// `entityType`: "student" | "teacher" | "staff". Atomik artış YALNIZCA
/// tek bir `INSERT ... ON CONFLICT ... DO UPDATE ... RETURNING` ifadesiyle
/// yapılır (bkz. src/lib/entity-sequence.ts) — okuma-artırma-yazma ARASINA
/// başka bir işlem giremez, eşzamanlı iki kayıt asla aynı numarayı almaz.
model EntitySequence {
  tenantId   String
  entityType String
  /// Bir SONRAKİ çağrıya atanacak numara (1'den başlar).
  nextValue  Int    @default(1)

  @@id([tenantId, entityType])
}

model Student {
  id                       String            @id
  tenantId                 String
  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Faz 12 — insan-okunur, değişmez kurum numarası (ör. "S00001").
  /// NULL = henüz numara atanmamış eski kayıt (backfill script'i doldurur).
  /// Kullanıcı tarafından değiştirilemez; yalnızca oluşturma anında/backfill'de yazılır.
  displayId                String?
  name                     String
  email                    String
  phone                    String
  /// SELF_MANAGED öğrencide boş olabilir — bkz. accountResponsibility.
  parentName               String?
  parentPhone              String?
  /// Karma Öğrenci Portalı — "PARENT_MANAGED" (varsayılan, veli iletişim/tahsilat
  /// muhatabı) | "SELF_MANAGED" (öğrenci kendi muhatabı). Erişim TÜRÜ (kimin portal
  /// hesabı olduğu) burada değil, StudentPortalAccess.accessType'ta tutulur — bu
  /// alan yalnızca "tahsilat/iletişim kime gider" iş kararıdır.
  accountResponsibility    String            @default("PARENT_MANAGED")
  /// Paket 7 — TC kimlik alanından hemen sonra istenir; opsiyonel.
  motherName               String?
  fatherName               String?
  /// P1 revizyonu (2026-09-10) — "Bizi nereden buldunuz?" Öğrenci kaydıyla
  /// kalıcı saklanır. İkisi de nullable/additive: mevcut satırlar backfill
  /// GEREKTİRMEZ, NULL okunduğunda uygulama "belirtilmemiş" gösterir.
  /// `referralSource`: instagram | google | tavsiye | referans |
  /// afis_etkinlik | diger (bkz. src/lib/types.ts REFERRAL_SOURCES).
  /// `referralSourceDetail`: diger seçiminde serbest metin açıklama.
  /// BU MİGRATION HİÇBİR VERİTABANINA UYGULANMADI — yalnızca dosya olarak
  /// eklendi (bkz. docs/agent-memory/PROJECT_STATE.md).
  referralSource           String?
  referralSourceDetail     String?           @db.Text
  branch                   Branch            @relation(fields: [branchId], references: [id])
  branchId                 String
  school                   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId                 String
  instruments              Json
  /// 2026-10-04 — öğrencinin EĞİTİM kayıtları (bir öğrenci, N eğitim): her biri kalıcı `id`, enstrüman,
  /// öğretmen, ders süresi, şube, aktiflik. NULL = eski tek eğitimli kayıt (instruments/teacherId/
  /// lessonDurationMinutes alanlarından türetilir). Lesson/LessonSeries/StudentContract.enrollmentId bu id'ye bağlanır.
  enrollments              Json?
  teacher                  Teacher           @relation(fields: [teacherId], references: [id])
  teacherId                String
  packageName              String
  weeklyLessonCount        Int
  monthlyFee               Int
  active                   Boolean
  notes                    String
  createdAt                DateTime          @default(now())
  /// Öğrenci kaydını açan kullanıcı (User.id). Eski kayıtlarda null — audit backfill.
  createdByUserId          String?
  /// Denemeden dönüştüyse kaynak TrialLesson.id ve dönüşümü onaylayan kullanıcı
  /// (kaydı açan kullanıcıdan farklı olabilir).
  convertedFromTrialId     String?
  convertedByUserId        String?
  /// EPIC 4 (IMPLEMENTATION_PLAN.md) — hepsi opsiyonel: geçmiş öğrenci
  /// kayıtları zorunlu backfill istemeden migration sonrası çalışmaya devam
  /// eder. "Hobi" | "MEB" | "London College of Music Hazırlık" |
  /// "Konservatuvar Hazırlık" | "Güzel Sanatlar Lisesi Hazırlık"
  studentType              String?
  /// Faz 1B — birden fazla öğrenci türü: string[] (StudentType değerleri).
  /// `studentType` (tekil) geriye dönük uyumluluk için korunur ve bu alan
  /// güncellenince ilk türle senkron tutulur (bkz. src/lib/student-types.ts).
  studentTypes             Json?
  /// P0 (2026-09-05) — KAYIT tarihi (öğrenci sisteme kaydedildi). Ders
  /// başlangıcı AYRI alandır: lessonStartDate.
  enrollmentStartDate      DateTime?
  /// P0 (2026-09-05) — DERSLERİN fiilen başladığı gün; kayıt tarihinden
  /// bağımsız seçilir. NULL = eski kayıt/gönderilmemiş → kayıt tarihi
  /// kullanılır (geriye dönük uyum). İlk tahsilat bu tarihten itibaren
  /// gerçekleşen dersleri sayar.
  lessonStartDate          DateTime?
  /// 2026-09-19 — kayıtta seçilen sözleşme süresi (ay, 1-12). Eskiden yalnız URL
  /// `?sure=` ile taşınıyordu; parametre düşünce Sözleşme Merkezi 3 aya dönüyordu.
  intendedDurationMonths   Int?
  /// K (2026-09-20) — kayıtta seçilen ders gün/saatleri ("Salı 15:00, Perşembe 16:00",
  /// kurum saat diliminde duvar saati). Sözleşme ve ders programı üretimi bunu
  /// TEK kaynak olarak okur; eskiden değer hiç saklanmıyordu.
  lessonScheduleText       String?
  enrollmentEndDate        DateTime?
  level                    String?
  targetExam               String?
  /// MEB Paneli (2026-09-28) — MEB seviye dönemi başlangıç/bitiş. Genel
  /// `enrollmentStartDate`/`lessonStartDate`/`enrollmentEndDate` alanlarından
  /// AYRI iş bilgisidir, oraya ASLA yazılmaz. Hepsi nullable/additive:
  /// mevcut satırlar backfill GEREKTİRMEZ, NULL okunduğunda uygulama
  /// "belirtilmemiş" gösterir; tür kaldırılınca SİLİNMEZ.
  mebLevelStartDate        DateTime?
  mebLevelEndDate          DateTime?
  /// MEB sınav tarihi (opsiyonel) + tri-state katılım (NULL = Bilinmiyor).
  /// Geçmiş kayıtlara "Girdi" varsayımı YOK.
  mebExamDate              DateTime?
  mebExamAttended          Boolean?
  specialNotes             String?
  /// EPIC 1 (IMPLEMENTATION_PLAN.md) — true ise veli otomatik tahsilat
  /// hatırlatma mesajlarından çıkmıştır; payment_reminders workflow'u ve
  /// scanOverduePaymentsTool bu öğrenciyi atlar. Manuel/idari mesajlaşmayı
  /// engellemez.
  communicationOptOut      Boolean           @default(false)
  /// PRODUCT_BACKLOG
  birthDate                DateTime?
  address                  String?
  nationalIdCipher         String?           @db.Text
  nationalIdLast2          String?
  educationMethod          String?
  lessonDurationMinutes    Int?
  paymentMethod            String?
  paymentAmount            Int?
  /// Ayın günü (1–31) vade hedefi — ay sonu taşması mevcut ödeme motoru
  /// (dueWindowForPaymentMethod) davranışıyla çözülür, burada özel bir hack yok.
  paymentDueDay            Int?
  /// Faz 1A — birden fazla ödeme günü/aralık tercihi: {start,end}[] (1-31,
  /// dahil). `paymentDueDay` (tekil) geriye dönük uyumluluk için korunur ve
  /// bu alan güncellenince ilk aralığın başlangıcıyla senkron tutulur (bkz.
  /// src/lib/payment-due-ranges.ts). NULL = yalnızca legacy tekil gün geçerli.
  paymentDueRanges         Json?
  /// Package C — paket+süre indirim ÖNCESİ liste fiyatı (bilgi/audit amaçlı).
  /// `monthlyFee` HER ZAMAN nihai (indirim/override uygulanmış) ücrettir.
  packageBaseMonthlyFee    Int?
  /// Package C: "percent" | "amount" (bkz. src/lib/packages.ts computeMonthlyFee).
  /// Paket Yönetimi (ÖNCELİK 4 devam): "percentage" | "fixed" (bkz.
  /// src/lib/student-payment-profile.ts computeStudentMonthlyAmount). İki ayrı
  /// yazma yolu aynı alanı paylaşır — bkz. src/lib/types.ts DiscountType.
  /// discountValue olmadan tek başına anlamsız — ikisi birlikte set edilir.
  discountType             String?
  discountValue            Float?
  /// true ise monthlyFee hesaplanan değerden farklı, admin tarafından elle girilmiştir.
  monthlyFeeManualOverride Boolean           @default(false)
  monthlyFeeOverrideReason String?           @db.Text
  /// Paket & Kampanya Motoru — kayıtta uygulanan kampanya id'leri (string[] JSON).
  /// NULL = kampanyasız/eski kayıt. Kampanya raporu bu alandan beslenir.
  appliedCampaignIds     Json?
  /// P0-1 (2026-09-02 düzeltme) — yönetici girmez; `derivePerLessonAmount`
  /// (monthlyFee ÷ (weeklyLessonCount×4)) ile sistemin ürettiği hesaplama
  /// snapshot'ı. NULL = LEGACY kayıt (mevcut tüm kayıtlar, düz monthlyFee),
  /// yalnız YENİ kayıtlarda otomatik dolar — asla client girdisi değildir.
  derivedPerLessonAmount   Int?
  firstLessonAt            DateTime?
  archivedAt               DateTime?
  /// Geri alınabilir silme (2026-09-22). Doluysa öğrenci varsayılan ekranlardan
  /// kaybolur; sözleşme/ödeme/evrak/audit satırları korunur. Yalnız SUPER_ADMIN.
  deletedAt                DateTime?
  deletedByUserId          String?
  deletionReason           String?
  /// ÖNCELİK 4 — "guz" (Eylül-Haziran) | "yaz" (Temmuz-Ağustos). Boşsa "guz"
  /// varsayılır (mevcut kayıtların çoğu normal dönem öğrencisi).
  termType                 String?
  /// ÖNCELİK 4 (devam) — Paket Yönetimi entegrasyonu. Additive: legacy
  /// öğrenciler packageId=NULL kalır ve serbest metin `packageName` ile
  /// görünmeye devam eder — bu FK hiçbir mevcut kaydı bozmaz/backfill etmez.
  /// Paket SİLİNMEZ (yalnız arşivlenir), bu yüzden onDelete: Restrict.
  package                  Package?          @relation(fields: [packageId], references: [id])
  packageId                String?
  birthPlace               String?
  schoolOrOccupation       String?
  /// Nilüfer Acar politikası §1E — gecikmiş ödeme nedeniyle YETKİLİ personelin
  /// bilinçli kararıyla ders programını geçici durdurması. Otomatik set EDİLMEZ
  /// (bkz. src/lib/services/tools.ts pauseStudentLessonScheduleTool) — yalnızca
  /// `active`/enrollment durumundan AYRI bir alan (kayıt sonlandırma/arşivleme
  /// ile karıştırılmasın diye). NULL = duraklatılmamış. Geçmiş yoklama/ders/
  /// ödeme kayıtları bu alandan ETKİLENMEZ, silinmez. Tam tarihçe AuditLog'da
  /// (contract/student pause/reactivate action'ları) tutulur; buradaki alanlar
  /// yalnızca GÜNCEL durumu taşır.
  paymentPauseStatus       String?
  paymentPausedAt          DateTime?
  paymentPauseReason       String?           @db.Text
  paymentPausedBy          String?
  /// Sosyal medya izni — MEVCUT `SocialMediaConsent` modelinde tutulur
  /// (öğrenci başına en güncel kayıt + tarihçe); Student üzerinde ayrı bir
  /// alan/paralel model YOK — bkz. src/lib/social-media-consent.ts.
  lessons                  Lesson[]
  lessonSeries             LessonSeries[]
  attendances              Attendance[]
  payments                 Payment[]
  makeupRequests           MakeupRequest[]
  contracts                StudentContract[]

  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([schoolId])
}

model Room {
  id           String         @id
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  branch       Branch         @relation(fields: [branchId], references: [id])
  branchId     String
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId     String
  capacity     Int
  instruments  Json
  /// ÖNCELİK 4 (devam) — oda pasife alma (hard delete YOK). Varsayılan true —
  /// mevcut odalar migration sonrası hiçbir davranış değişikliği görmez.
  active       Boolean        @default(true)
  archivedAt   DateTime?
  /// 8. tur — pasif oda silme = soft delete; geçmiş dersler oda adını korur.
  deletedAt    DateTime?
  lessons      Lesson[]
  lessonSeries LessonSeries[]

  @@index([tenantId])
}

model Lesson {
  id                      String        @id
  tenantId                String
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student                 Student       @relation(fields: [studentId], references: [id])
  studentId               String
  teacher                 Teacher       @relation(fields: [teacherId], references: [id])
  teacherId               String
  room                    Room          @relation(fields: [roomId], references: [id])
  roomId                  String
  branch                  Branch        @relation(fields: [branchId], references: [id])
  branchId                String
  school                  School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId                String
  instrument              String
  startAt                 DateTime
  endAt                   DateTime
  type                    String
  /// EPIC 8 (IMPLEMENTATION_PLAN.md) — "scheduled"|"in_progress"|"completed"|
  /// "cancelled"|"no_show". Canlı durum (gecikmiş vb.) SAKLANMAZ, her zaman
  /// startAt/actualStartAt'tan TÜRETİLİR (bkz. src/lib/lesson-live-status.ts).
  status                  String
  makeupRequestId         String?
  series                  LessonSeries? @relation(fields: [seriesId], references: [id])
  seriesId                String?
  /// 2026-10-04 — dersin ait olduğu eğitim (Student.enrollments[].id); NULL = eski ders (enstrümandan çözülür).
  enrollmentId            String?
  /// 2026-10-06 — kulüp oturumu satırı (`type = "group"`): üye başına bir satır, aynı oturumun satırları
  /// `clubSessionId` ile bağlı (birbirleriyle çakışma saymaz; başka derslerle sayar). Hakediş oturum başına bir kez.
  clubId                  String?
  clubSessionId           String?
  notes                   String?
  /// Dersi planlayan kullanıcı (User.id). Eski kayıtlarda null.
  createdByUserId         String?
  /// EPIC 8 — öğretmenin "Dersi başlat"/"Dersi bitir" ile damgaladığı GERÇEK
  /// zaman damgaları (planlanan startAt/endAt'tan bağımsız, nullable —
  /// geçmiş dersler dolu olmayabilir). Düzeltme yalnızca admin tarafından ve
  /// yalnızca zorunlu bir notla yapılabilir (bkz. correctLessonTimesTool).
  actualStartAt           DateTime?
  actualEndAt             DateTime?
  startCorrectedBy        String?
  startCorrectionNote     String?
  endCorrectedBy          String?
  endCorrectionNote       String?
  /// Geldi / İşlendi / Telafi operasyonel bayraklar
  studentAttended         Boolean       @default(false)
  studentAttendedAt       DateTime?
  studentAttendedBy       String?
  lessonProcessed         Boolean       @default(false)
  lessonProcessedAt       DateTime?
  lessonProcessedBy       String?
  /// P0-2 — "İşlendi" işaretlenirken zorunlu, kullanıcı girdisi gerekçe.
  lessonProcessedReason   String?
  opsMakeupFlag           Boolean       @default(false)
  opsMakeupFlagAt         DateTime?
  opsMakeupFlagBy         String?
  /// Yoklama kapanışı — Gelmedi (mazeretsiz) / Mazeretli. Geldi/İşlendi/
  /// Telafi ile AYNI birbirini dışlayan tek-statü mekanizması, mali sonuç yok.
  studentAbsent           Boolean       @default(false)
  studentAbsentAt         DateTime?
  studentAbsentBy         String?
  studentExcused          Boolean       @default(false)
  studentExcusedAt        DateTime?
  studentExcusedBy        String?
  /// ÖNCELİK 4 — Yoklama Takvimi'nin 4. statüsü ("Kapalı", siyah). Telafi
  /// gibi hiçbir mali sonuç doğurmaz; yalnız yeni takvim ekranından set
  /// edilir, mevcut Program/Yoklama'nın 3 butonlu hızlı aksiyonuna eklenmez.
  opsClosedFlag           Boolean       @default(false)
  opsClosedFlagAt         DateTime?
  opsClosedFlagBy         String?
  /// ÖNCELİK 4 (devam) — akademik dönem etiketi, LessonSeries ile aynı kural
  /// (NULL = legacy, tarih tabanlı fallback ile çözülür). Seriden üretilen
  /// dersler serinin term/academicYearStart'ını miras alır; tek seferlik
  /// (seriye bağlı olmayan) dersler oluşturma anında UI'nin seçili
  /// yıl/dönemini alır.
  term                    String?
  academicYearStart       Int?
  /// İş 3 — öğretmenin kendi bildirdiği çalışma saatleri DIŞINDA, kullanıcının
  /// "Yine de planla" onayıyla oluşturuldu (bkz. OVERRIDABLE_SLOT_CODES,
  /// src/lib/makeup-engine.ts). Diğer tüm çakışma/uyumsuzluk türleri asla
  /// override edilemez — bu iki alan yalnızca bu TEK durum için dolar.
  availabilityOverrideBy  String?
  availabilityOverrideAt  DateTime?
  /// Faz 2 — öğretmenin KENDİ derse gelip gelmediği, öğrenci yoklamasından
  /// bağımsız. "geldi" | "gelmedi" | "mazeretli"; NULL = Bekliyor.
  teacherAttendanceStatus String?
  teacherAttendanceAt     DateTime?
  teacherAttendanceBy     String?
  teacherAttendanceNote   String?       @db.Text
  /// 9. tur — İptal/Telafi kararının KAYNAĞI, öğretmen katılımından ve ders
  /// statüsünden AYRI alan: "teacher" | "institution" | "student" | "other".
  /// NULL = belirtilmemiş (eski kayıtlar sessizce öğretmene/kuruma atanmaz).
  /// teacher/institution kaynaklı telafi öğrencinin kişisel telafi hakkından düşmez.
  disruptionSource        String?
  disruptionNote          String?       @db.Text
  disruptionAt            DateTime?
  disruptionBy            String?
  attendances             Attendance[]

  @@index([tenantId])
  @@index([schoolId])
  @@index([seriesId])
  @@index([tenantId, term, academicYearStart])

  @@index([tenantId, clubSessionId])
}

/// Haftalık tekrarlayan ders serisi — dönem boyunca üretilen Lesson
/// kayıtlarının kaynağı. Lesson.seriesId ile bağlanır; seri silinmez,
/// yalnızca status ile pasifleştirilir (cancelled/ended).
model LessonSeries {
  id                String   @id
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Student  @relation(fields: [studentId], references: [id])
  studentId         String
  teacher           Teacher  @relation(fields: [teacherId], references: [id])
  teacherId         String
  room              Room     @relation(fields: [roomId], references: [id])
  roomId            String
  branch            Branch   @relation(fields: [branchId], references: [id])
  branchId          String
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId          String
  instrument        String
  /// 2026-10-04 — serinin ait olduğu eğitim (Student.enrollments[].id).
  enrollmentId      String?
  /// 0=Pazar ... 6=Cumartesi (mevcut Teacher.availability ile aynı kural)
  weekday           Int
  /// "HH:mm" — mevcut workingHours alanlarıyla aynı biçim
  startTime         String
  durationMinutes   Int
  startsOn          DateTime
  endsOn            DateTime
  status            String
  lessons           Lesson[]
  /// K (2026-09-20) — seriyi üreten StudentContract kimliği (varsa). Yaşam
  /// döngüsü bağlantısıdır, KİLİT DEĞİLDİR: sözleşme iptalinde dersler
  /// otomatik silinmez, kullanıcı onayı istenir (bkz. src/lib/types.ts
  /// LessonSeries.contractId yorumu). FK tanımlanmadı — sözleşme kaydı
  /// arşivden kaldırılsa bile ders geçmişi sorgulanabilir kalmalı.
  contractId        String?
  /// ÖNCELİK 4 (devam) — akademik dönem etiketi ("guz"|"yaz"). NULL = legacy
  /// kayıt (bu alan eklenmeden önce oluşturuldu); okuma tarafı NULL'ı asla
  /// hata saymaz, tarihe göre güvenli fallback uygular (bkz.
  /// src/lib/attendance-calendar.ts resolveLessonAcademicPeriod). Bilinçli
  /// olarak backfill migration'ı YOK — var olan seriler veri kaybı olmadan
  /// NULL/legacy olarak kalır.
  term              String?
  /// Akademik yılın başlangıç takvim yılı (ör. 2026 => "2026–2027 Güz" ya da
  /// "2026 Yaz"). NULL = legacy, aynı fallback kuralı geçerli.
  academicYearStart Int?
  /// Faz 6 — demo/test amaçlı otomatik üretilmiş serileri işaretler (ör.
  /// "demo-schedule-seed"). NULL = gerçek (insan tarafından oluşturulmuş)
  /// seri. Yalnızca tanımlayıcı bir etiket — hiçbir iş kuralı buna bakmaz.
  demoTag           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([schoolId])
  @@index([tenantId, term, academicYearStart])
  @@index([contractId])
}

/// Öğretmen dakika-başı ücreti. `branchId`/`instrument` null ise o alan
/// için "tüm şubeler"/"tüm enstrümanlar" anlamına gelir. Aynı kapsamda
/// (teacherId+branchId+instrument) tarihi çakışan iki kural uygulama
/// katmanında engellenir (bkz. src/lib/teacher-payout.ts validateFeeRuleInput).
model TeacherFeeRule {
  id            String    @id
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher       Teacher   @relation(fields: [teacherId], references: [id])
  teacherId     String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId      String
  branch        Branch?   @relation(fields: [branchId], references: [id])
  branchId      String?
  instrument    String?
  perMinuteRate Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  deactivatedAt       DateTime?
  deactivatedByUserId String?
  deactivationReason  String?

  @@index([tenantId])
  @@index([teacherId])
}

/// Bir dönem için öğretmene ödenecek/ödenen tutarın donmuş (snapshot)
/// kaydı. totalMinutes/totalAmount oluşturma anında hesaplanır ve
/// TeacherFeeRule sonradan değişse bile bir daha yeniden hesaplanmaz.
/// Payment (öğrenci -> okul) ile ilişkisi yoktur, bilinçli olarak ayrıdır.
model TeacherPayout {
  id           String    @id
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher      Teacher   @relation(fields: [teacherId], references: [id])
  teacherId    String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId     String
  periodStart  DateTime
  periodEnd    DateTime
  totalMinutes Int
  totalAmount  Float
  status       String
  paidAt       DateTime?
  method       String?
  generatedAt  DateTime  @default(now())
  /// Revizyon: ilk revizyonda donan orijinal hesap; satır bazlı elle düzeltmeler (lessonId → {minutes, hourlyRate, amount}).
  originalTotalMinutes Int?
  originalTotalAmount  Float?
  lineOverrides        Json?
  revisionCount        Int       @default(0)
  revisedAt            DateTime?
  revisedByUserId      String?
  revisionReason       String?
  /// 2026-09-29 — kayıt anındaki hakediş politikası ("per_teacher_rule" | "fixed_duration" | "mixed");
  /// NULL = eski kayıt (öğretmen bazlı dakika ücreti). pricingSnapshot: ay → politika + sabit tutarlar.
  pricingPolicy        String?
  pricingSnapshot      Json?
  /// 2026-09-30 — iptal (status "cancelled"), donmuş ders kalemleri, ödeme ve düzeltme defteri, eşzamanlılık.
  cancelledAt          DateTime?
  cancelledByUserId    String?
  cancelReason         String?
  lineSnapshot         Json?
  payments             Json?
  adjustments          Json?
  version              Int       @default(0)

  @@unique([teacherId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([teacherId])
}

/// 2026-09-29 — ay bazlı öğretmen hakediş politikası (kurum geneli). Satır yoksa o ay mevcut politika
/// (öğretmen bazlı TeacherFeeRule) geçerlidir. O ayla kesişen TeacherPayout varsa uygulama katmanı
/// değişikliği reddeder (bkz. src/lib/teacher-payout.ts setPayoutPolicyForMonthData).
model TeacherPayoutPolicyPeriod {
  id          String   @id
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "yyyy-MM"
  month       String
  /// "per_teacher_rule" | "fixed_duration"
  policy      String
  /// Yalnız fixed_duration: ders başı TL (30/40/50 dk).
  rate30      Float?
  rate40      Float?
  rate50      Float?
  setByUserId String
  setAt       DateTime
  createdAt   DateTime @default(now())

  @@unique([tenantId, month])
}

/// 2026-09-30 — dersi hakedişten hariç tutma (Lesson/yoklama/ödeme DEĞİŞMEZ). Satır silinince ders tekrar sayılır.
model TeacherPayoutExclusion {
  id              String   @id
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessonId        String
  teacherId       String
  reason          String
  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([tenantId, lessonId])
}

model Attendance {
  id                             String         @id @default(cuid())
  tenantId                       String
  tenant                         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson                         Lesson         @relation(fields: [lessonId], references: [id])
  lessonId                       String         @unique
  student                        Student        @relation(fields: [studentId], references: [id])
  studentId                      String
  status                         String
  reason                         String?
  markedAt                       DateTime
  createsMakeupCredit            Boolean
  school                         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId                       String
  makeupRequest                  MakeupRequest?
  /// 2026-2027 sözleşme kaynağı Madde 8 — "aynı gün bildirilen iptal" kuralını
  /// GÜVENİLİR şekilde uygulamak için `markedAt`'tan (personelin yoklamayı
  /// İŞLEME zamanı) AYRI, açıkça personel tarafından girilen iptal bildirim
  /// alanları. Hepsi nullable/opsiyonel — mevcut/legacy kayıtlar bozulmaz,
  /// bu alanlar YALNIZCA UI bunları açıkça sunduğunda doldurulur (bkz.
  /// docs/roadmap/NEVIIHUB_ADMIN_CONTRACTS_POLICY_REMAINING_WORK.md §5 — UI
  /// wiring henüz YAPILMADI, bu şema yalnızca forward-compatible zemin).
  cancellationSource             String?
  cancellationNoticeAt           DateTime?
  cancellationReason             String?
  cancellationEvidenceDocumentId String?
  /// Hesaplanan telafi uygunluk sonucu — nullable (legacy kayıtlarda hiç
  /// hesaplanmamıştır, "bilinmiyor" ile "uygun değil"i KARIŞTIRMAZ).
  telafiEligible                 Boolean?

  @@index([tenantId])
}

model MakeupRequest {
  id                 String     @id @default(cuid())
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student            Student    @relation(fields: [studentId], references: [id])
  studentId          String
  teacher            Teacher    @relation(fields: [teacherId], references: [id])
  teacherId          String
  branch             Branch     @relation(fields: [branchId], references: [id])
  branchId           String
  school             School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId           String
  instrument         String
  sourceLessonId     String
  attendance         Attendance @relation(fields: [attendanceId], references: [id])
  attendanceId       String     @unique
  status             String
  reason             String
  expiresAt          DateTime
  suggestedSlots     Json
  confirmedLessonId  String?
  createdAt          DateTime
  policyNote         String
  /// EPIC 10 (IMPLEMENTATION_PLAN.md) — hepsi opsiyonel/additive. decisionNote
  /// yalnızca uygulama katmanında (confirmMakeupLessonTool/cancelMakeupLessonTool)
  /// zorunlu kılınır, şemada nullable kalır ki geçmiş kayıtlar bozulmasın.
  /// slaDeadline yalnızca onaylandığında set edilir; slaEscalationLevel:
  /// 0=yok 1=15gün 2=7gün 3=3gün 4=1gün 5=aşıldı (bkz. resolveSlaEscalationLevel).
  decisionNote       String?
  decidedBy          String?
  decidedAt          DateTime?
  slaDeadline        DateTime?
  slaEscalationLevel Int        @default(0)

  @@index([tenantId])
  @@index([sourceLessonId])
}

model Payment {
  id                  String                @id
  tenantId            String
  followUps           PaymentFollowUpCase[]
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student             Student               @relation(fields: [studentId], references: [id])
  studentId           String
  school              School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId            String
  amount              Int
  paidAmount          Int
  status              String
  dueDate             DateTime
  paidAt              DateTime?
  description         String
  method              String?
  /// Paket 5 — "Ödendi işaretle" modalında girilen isteğe bağlı referans/açıklama notu.
  paymentNote         String?
  /// Otomatik ders bazlı tahsilatın kaynak dersi — manuel/paket ödemelerde NULL.
  lessonId            String?
  /// "manual" (varsayılan, mevcut tüm kayıtlar) | "lesson_ops" (Geldi/İşlendi otomatik oluşturdu)
  source              String                @default("manual")
  /// Tahsilatı ALAN kullanıcının kalıcı kimliği — `markPaymentPaid`'in ortak
  /// yolundan (Ödemeler "Ödendi işaretle", Yoklama Takvimi "Tahsil Et" ve ay
  /// kutusu Kaydet) her "ödendi" geçişinde `ctx.userId`'den yazılır. FK YOK
  /// (AuditLog/AiAuditLog ile aynı gerekçe — tahsilatı yapan kullanıcı
  /// silinse bile geçmiş kayıt okunabilir kalır). NULL = henüz tahsil
  /// edilmemiş veya bu alan eklenmeden önce tahsil edilmiş (legacy).
  receivedByUserId    String?
  /// FEATURE A (versioned enrollment contracts) — bu ödeme bir
  /// `StudentContract` taksit planının parçasıysa dolu. Additive/nullable:
  /// mevcut hiçbir `Payment` satırını etkilemez, mevcut tahsilat/makbuz/
  /// hatırlatma/gecikme akışları bu satırları normal `Payment` gibi işlemeye
  /// devam eder (bkz. src/lib/contracts.ts — kasıtlı olarak
  /// `upsertMonthlyPlanPayment`'ı YENİDEN KULLANMAZ: o, öğrencinin AÇIK UÇLU
  /// süregelen aylık faturalama motorudur — contractId'li satırlar ise BELİRLİ
  /// bir sözleşmenin SABİT SAYIDA taksitidir; ikisini aynı upsert yoluna
  /// sokmak iki farklı yaşam döngüsünü birbirine karıştırırdı).
  contractId          String?
  contract            StudentContract?      @relation(fields: [contractId], references: [id])
  /// 2026-10-05 — kulüp aylık ücreti satırı (`source = "club"`); hangi üyeliğin hangi ayı (`installmentPeriodLabel`).
  /// Sözleşmeye hiçbir koşulda bağlanmaz/taşınmaz.
  clubMembershipId    String?
  /// 2026-10-09 — satırın ait olduğu BRANŞ KAYDI (Student.enrollments[].id). Sözleşme taksidinde sözleşmenin
  /// eğitimiyle aynıdır; sözleşmesiz satırda (kayıt ilk tahsilatı, aylık plan, ders bazlı, elle) tek açık bağdır.
  /// NULL = eski kayıt: öğrencinin tek branşı varsa ona aittir, birden fazlaysa "branşı belirtilmemiş" sayılır.
  enrollmentId        String?
  /// 1-tabanlı taksit sırası — yalnızca contractId doluyken anlamlı.
  installmentSequence Int?
  /// P0-1B — bu ödeme, motorun ürettiği otomatik tutardan MANUEL olarak
  /// farklı girildiyse dolu (bkz. src/lib/first-payment-adjustment.ts).
  /// `amount` HER ZAMAN fiilen tahsil edilen net tutardır — bu 4 alan
  /// yalnızca "otomatik hesaplananla farkı" audit için ayrıca taşır.
  autoSuggestedAmount Int?
  adjustmentReason    String?
  adjustedBy          String?
  adjustedAt          DateTime?
  /// Sahip kararı (2026-09-16) — ilk tahsilat takip eden ayın tam ücretini de
  /// kapsıyor mu (kayıt ekranındaki açık seçim; sözleşme planı bunu okur).
  firstCollectionIncludesNextMonth Boolean?
  /// P0 (2026-09-03) — taksit satırının GÖRÜNÜR tahsilat türü ("first_collection" |
  /// "first_collection_combined" | "period_fee" | "deposit"). Yalnızca contractId
  /// dolu (taksit) satırlarda anlamlı; tüm mevcut Payment satırlarında NULL kalır,
  /// geriye dönük hiçbir davranışı etkilemez (bkz. src/lib/types.ts ContractInstallmentKind).
  installmentKind             String?
  /// Kapsanan dönem(ler)in okunabilir etiketi, ör. "17–30 Eylül 2026 + Ekim 2026".
  installmentPeriodLabel      String?
  /// installmentKind="first_collection_combined" iken dönem bazlı tutar kırılımı (JSON dizi).
  installmentBreakdown        Json?
  /// Bu satırın tutarı otomatik mi hesaplandı yoksa manuel mi girildi ("auto" | "manual").
  installmentComputationSource String?
  /// computationSource="manual" ise personelin girdiği gerekçe.
  installmentNote             String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, lessonId])
  @@index([tenantId, contractId])
  @@index([tenantId, studentId, enrollmentId])
}

/// Online kredi kartı checkout denemesi — provider-hosted (kart verisi asla
/// bu tabloya veya uygulamaya gelmez, yalnızca sağlayıcının checkout URL'i +
/// referansı). `Payment`'a alan EKLENMEDİ (bilinçli karar) — mevcut manuel
/// tahsilat/geçmiş/void/idempotency akışı hiç değişmiyor; bu tablo yalnızca
/// "hangi checkout denemeleri oldu" izlenebilirliği için ayrı ve additive.
model PaymentCheckoutAttempt {
  id                String    @id
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId         String
  studentId         String
  initiatedByUserId String
  /// "console" | "iyzico" | "stripe" — bkz. src/lib/payment-provider/config.ts
  provider          String
  providerReference String?
  /// Sağlayıcının barındırdığı checkout sayfası URL'i — YALNIZCA idempotent
  /// tekrar kullanım için (double-click/retry aynı pending attempt'i tekrar
  /// provider'ı ÇAĞIRMADAN döner). Kart/CVV verisi DEĞİLDİR — kullanıcının
  /// zaten görebileceği, tek-kullanımlık bir yönlendirme linkidir.
  checkoutUrl       String?
  /// "pending" | "succeeded" | "failed" | "expired"
  status            String    @default("pending")
  amount            Int
  currency          String
  idempotencyKey    String
  expiresAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, paymentId])
  @@index([tenantId, studentId])
  @@index([tenantId, providerReference])
}

model PaymentFollowUpCase {
  id                     String    @id
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId              String
  payment                Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  studentId              String
  status                 String    @default("draft")
  messageDraft           String
  approvedBy             String?
  approvedAt             DateTime?
  sentAt                 DateTime?
  resolvedAt             DateTime?
  attributedAmount       Int       @default(0)
  openingBalance         Int?
  currentBalance         Int?
  currency               String?   @default("TRY")
  dueDate                DateTime?
  daysOverdue            Int?
  selectedChannel        String?
  approvedMessage        String?
  lastError              String?
  closedAt               DateTime?
  attributedPaidSnapshot Int       @default(0)
  attempts               Json?
  events                 Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([paymentId])
  @@index([tenantId, paymentId])
}

/// Kalıcı SMS/WhatsApp iletişim taslağı ve onay kaydı (İletişim Merkezi, FAZ2).
/// Bildirimler (Notification modeli) ile karıştırılmaz — bu, dış SMS/WhatsApp kuyruğudur.
model CommunicationMessage {
  id                    String    @id
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientType         String
  recipientId           String
  recipientName         String
  recipientPhone        String
  channel               String
  messageType           String
  resourceType          String
  resourceId            String
  status                String    @default("pending_approval")
  draftBody             String
  approvedBodySnapshot  String?
  /// P1 (2026-09-11) — WhatsApp onaylı-şablon anahtarı (nullable/additive).
  /// BU MİGRATION HİÇBİR VERİTABANINA UYGULANMADI.
  templateKey           String?
  createdBy             String
  approvedBy            String?
  approvedAt            DateTime?
  attemptCount          Int       @default(0)
  providerResultCode    String?
  providerResultSummary String?
  blockedReasonCode     String?
  blockedReasonMessage  String?
  idempotencyKey        String
  approvalBatchId       String?
  events                Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, channel, messageType])
}

/// SMS inbound/delivery webhook idempotency (provider message id + kind).
model SmsInboundEvent {
  id                String   @id
  providerMessageId String
  kind              String
  tenantId          String?
  processedAt       DateTime @default(now())

  @@unique([providerMessageId, kind])
  @@index([tenantId])
}

/// EPIC 1 (IMPLEMENTATION_PLAN.md) — uygulama içi bildirim (veli portalı vb).
/// `targetUserId`/`targetStudentId` bilerek `@relation` ile bağlanmaz: bir
/// bildirim hedef kayıt silinse bile okunabilir kalmalı (audit-log benzeri
/// dayanıklılık). Erişim her zaman tenantId + (targetUserId veya
/// targetStudentId) ile kapsamlanır — bkz. src/lib/notifications.
model Notification {
  id              String    @id
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetUserId    String?
  targetStudentId String?
  kind            String
  title           String
  body            String
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, targetUserId])
  @@index([tenantId, targetStudentId])
}

/// İş 4 (yönetici bildirim tercihleri sprint'i) — kullanıcı+kategori bazlı
/// bildirim tercihi. userId + category tenant-safe bir çift olarak
/// benzersizdir (bir kullanıcı bir kategoriyi yalnızca BİR kez ayarlar).
/// pushEnabled şimdilik yalnızca ileriye dönük alan — bu sprintte gerçek
/// push altyapısı YOK, her zaman false/opsiyonel kalır (bkz.
/// src/lib/notification-categories.ts).
///
/// Migration NOT çalıştırıldı — gerekirse:
///   npx prisma migrate dev --name notification_preferences
model NotificationPreference {
  id           String   @id
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  category     String
  inAppEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, userId, category])
  @@index([tenantId, userId])
}

/// EPIC 5 (IMPLEMENTATION_PLAN.md) — duyuru merkezi. `audienceType`:
/// "all" | "branch" | "teachers" | "parents" | "students" | "studentType" |
/// "selected". `audienceRef` yalnızca branch/studentType/selected için
/// dolu olur (sırasıyla {branchId}/{studentType}/{userIds}) — hedef kitle
/// eşleştirmesi SUNUCU tarafında yapılır (src/lib/announcements), asla
/// client'a hedef-dışı veri gönderilmez.
model Announcement {
  id             String             @id
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  body           String
  attachmentUrl  String?
  /// En fazla 3 ek: [{ id, fileName, mimeType, sizeBytes, storageKey, uploadedAt }]
  attachments    Json?
  audienceType   String
  audienceRef    Json?
  /// Faz 4 — çoklu segment (OR): [{ audienceType, audienceRef }]. Yoksa audienceType/audienceRef tek kural sayılır.
  rules          Json?
  /// "draft" | "published" | "archived"
  status         String             @default("draft")
  pinned         Boolean            @default(false)
  publishAt      DateTime?
  expireAt       DateTime?
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  /// Faz 4 — yayınlanma anında çözülen benzersiz alıcı (Notification) sayısı.
  recipientCount Int?
  reads          AnnouncementRead[]

  @@index([tenantId, status])
}

/// 2026-10-05 — Günlük Özet "Notlar": personelin sonraki vardiyaya bıraktığı serbest not. Yalnız eklenir;
/// kim (userId + yazıldığı andaki ad) ve ne zaman kalıcıdır.
model PanelNote {
  id              String   @id
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  body            String
  createdByUserId String
  createdByName   String
  createdAt       DateTime @default(now())
  /// 2026-10-06 — son düzenleme (kim/ne zaman); metin yerinde güncellenir.
  updatedAt       DateTime?
  updatedByUserId String?
  updatedByName   String?
  /// Silme = gizleme (kayıt kalır): kritik şifre + gerekçe ile (guardCriticalDelete).
  deletedAt       DateTime?
  deletedByUserId String?
  deletionReason  String?

  @@index([tenantId, createdAt])
}

/// Bir kullanıcının bir duyuruyu okuduğu an — @@unique çift okuma kaydı
/// oluşmasını engeller (aynı kullanıcı tekrar "okundu" işaretlerse upsert).
model AnnouncementRead {
  id             String       @id
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

/// EPIC 7 (IMPLEMENTATION_PLAN.md) — öğretmen gelişim değerlendirme formu.
/// A–E bölümlerinin her maddesi DÜZ SÜTUN (1–5, Int) — JSON değil, çünkü
/// trend/rapor SQL agregasyonu gerektiriyor. lessonId/studentId/teacherId
/// bilerek @relation ile bağlanmaz (Notification/Announcement ile aynı
/// gerekçe — bu sprint yalnızca bu tabloyu ekliyor, başka model dokunulmuyor;
/// erişim her zaman tenantId + studentId/teacherId ile kapsamlanır).
model LessonAssessment {
  id                         String   @id
  tenantId                   String
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessonId                   String
  studentId                  String
  teacherId                  String
  /// A. Teknik
  teknikBecerisi             Int
  notaOkuma                  Int
  /// B. Müzikalite
  muzikalite                 Int
  ritimDuyusu                Int
  /// C. Çalışma Disiplini
  calismaDuzeni              Int
  evOdeviTamamlama           Int
  /// D. Katılım
  dersKatilimi               Int
  motivasyon                 Int
  /// E. Genel Gelişim
  genelIlerleme              Int
  hedefeUlasma               Int
  /// Faz 3A — "çalışılan konular" (hepsi opsiyonel serbest metin).
  piecesWorked               String?  @db.Text
  etudesWorked               String?  @db.Text
  technicalWork              String?  @db.Text
  theoryWork                 String?  @db.Text
  strengthNote               String
  nextStepsNote              String
  improvementNote            String
  /// Yalnızca veli/yönetici görür; öğrenciye gösterilmesi için öğretmen
  /// açıkça parentNoteVisibleToStudent'ı true yapmalı (varsayılan false).
  parentPrivateNote          String?
  parentNoteVisibleToStudent Boolean  @default(false)
  teacherSignedName          String
  /// Sunucu saatiyle damgalanır — client'tan gelen tarihe güvenilmez.
  teacherSignedAt            DateTime
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, teacherId])
  @@index([lessonId])
}

/// Faz 3B — dört haftalık genel gelişim değerlendirmesi. `LessonAssessment`
/// (ders bazlı) İLE KARIŞMAZ — bu, bir DÖNEM (periodStart..periodEnd)
/// boyunca genel bir değerlendirmedir. "Bekleyen" (henüz gönderilmemiş)
/// değerlendirmeler bu tabloda hiç YOK — pending durumu her zaman TAZE
/// hesaplanır (bkz. src/lib/periodic-assessment/index.ts
/// computePendingPeriodicAssessmentPeriods): öğrencinin ilk ders tarihinden
/// başlayarak 4 haftalık dönemler türetilir, HANGİLERİ için bu tabloda
/// zaten "submitted" bir kayıt YOKSA o dönem "bekliyor" sayılır. Böylece
/// aynı öğrenci+dönem için asla İKİNCİ bir satır oluşmaz (`@@unique`) ve
/// ayrı bir zamanlanmış iş/worker GEREKMEZ.
model PeriodicAssessment {
  id                      String   @id
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId               String
  teacherId               String
  periodStart             DateTime
  periodEnd               DateTime
  /// İlişkili derslerin id'leri (bilgi amaçlı, denormalize — bkz. Task.relatedEntityLabel deseni).
  relatedLessonIds        Json
  overallProgressNote     String   @db.Text
  strengthsNote           String?  @db.Text
  areasForImprovementNote String?  @db.Text
  recommendationNote      String?  @db.Text
  submittedBy             String
  submittedAt             DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([tenantId, studentId, teacherId, periodStart, periodEnd])
  @@index([tenantId, studentId])
  @@index([tenantId, teacherId])
}

/// EPIC 9 (IMPLEMENTATION_PLAN.md) — öğretmenin müsaitlik değişikliği önerisi.
/// `Teacher.availability` bu tablo ÜZERİNDEN değişir: TEACHER yalnızca öneri
/// oluşturur (status="pending"), SCHOOL_ADMIN/SUPER_ADMIN onaylayınca öneri
/// `Teacher.availability`'ye UYGULANIR (src/lib/teacher-availability.ts +
/// tool katmanındaki reviewTeacherAvailabilityRequestTool). İlk öğretmen
/// kaydındaki müsaitlik (createTeacherTool) bu akışın DIŞINDADIR — yalnızca
/// öğretmenin KENDİ yaptığı sonraki değişiklikler onaya girer.
model TeacherAvailabilityRequest {
  id                   String    @id
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId            String
  proposedAvailability Json
  exceptions           Json?
  /// "pending" | "approved" | "rejected"
  status               String    @default("pending")
  reviewNote           String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId, teacherId, status])
}

/// EPIC 6B (IMPLEMENTATION_PLAN.md) — öğretmenin bir öğrenciye verdiği ödev.
model Homework {
  id           String               @id
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId    String
  studentId    String
  /// Faz 3C — bu ödevin verildiği ders (opsiyonel — geçmiş/ders-dışı ödevler için NULL).
  lessonId     String?
  title        String
  description  String
  dueDate      DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  submissions  HomeworkSubmission[]
  /// Paket 7 — öğretmenin ödevi verirken eklediği isteğe bağlı dosya/foto/video (base64).
  fileName     String?
  fileMimeType String?
  fileData     String?

  @@index([tenantId, studentId])
  @@index([tenantId, teacherId])
  @@index([tenantId, lessonId])
}

/// Öğrencinin bir ödeve yaptığı teslim. Dosya küçük dosya/foto/kısa video
/// için DB'de (base64) saklanır — EPIC 6 planının "(A) seçeneği": yeni bir
/// obje depolama bağımlılığı (S3/R2) eklemeden, mevcut altyapıyla. Erişim
/// ASLA herkese açık/tahmin edilebilir bir URL ile değil, oturum + sahiplik
/// kontrolüyle yapılır (bkz. GET /api/v1/homework-submissions/[id]/file).
model HomeworkSubmission {
  id              String    @id
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homework        Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  homeworkId      String
  studentId       String
  note            String?
  fileName        String?
  fileMimeType    String?
  fileData        String?
  submittedAt     DateTime  @default(now())
  teacherFeedback String?
  reviewedAt      DateTime?

  @@index([tenantId, homeworkId])
  @@index([tenantId, studentId])
}

/// EPIC 6B — öğretmenin öğrenci türü/enstrüman/seviyeye (EPIC 4 alanları)
/// hedefleyerek paylaştığı materyal/pratik videosu. Hedefleme alanlarının
/// HEPSİ null ise öğretmenin TÜM öğrencilerine görünür.
model TeachingMaterial {
  id                String   @id
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId         String
  title             String
  description       String
  targetStudentType String?
  targetInstrument  String?
  targetLevel       String?
  fileName          String?
  fileMimeType      String?
  fileData          String?
  createdAt         DateTime @default(now())

  @@index([tenantId, teacherId])
}

/// EPIC 6C (IMPLEMENTATION_PLAN.md) — veli/öğrencinin öğretmen hakkında
/// yapılandırılmış geri bildirimi. Kamuya açık ortalama/sıralama YOK;
/// yalnızca SCHOOL_ADMIN/SUPER_ADMIN görür. Öğretmen kendi ortalamasını
/// GÖRMEZ (ilk sürüm, kötüye kullanım riskini azaltmak için bilinçli karar).
model TeacherFeedback {
  id                  String   @id
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId           String
  studentId           String
  submittedBy         String
  submitterRole       String
  scores              Json
  /// "yes" | "unsure" | "no"
  continueWithTeacher String?
  comment             String?
  /// "pending" | "reviewed" | "actioned" | "archived"
  status              String   @default("pending")
  /// Yönetici bu yorumu öğretmenin anonim özetinde paylaşmayı SEÇTİYSE true.
  sharedWithTeacher   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId, teacherId])
  @@index([tenantId, status])
  @@index([tenantId, studentId, teacherId])
}

/// Öğretmenin öğrenciyi değerlendirmesi (Karşılıklı Değerlendirmeler sprinti).
/// TeacherFeedback'in TERSİ yönü — burada öğretmen değerlendiriyor, öğrenci/veli
/// DEĞİL. Ham kayıt yalnızca yönetici ve ilgili öğretmene açık; öğrenci/veli
/// göremez (bkz. src/lib/student-feedback.ts gizlilik notu).
model StudentFeedback {
  id          String   @id
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId   String
  studentId   String
  submittedBy String
  /// { attendance, practice, progress, attitude, preparedness } → 1-5
  scores      Json
  comment     String?
  /// "pending" | "reviewed" | "actioned" | "archived"
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, teacherId])
  @@index([tenantId, status])
  @@index([tenantId, studentId, teacherId])
}

/// Recurring autonomous workflow state — per-workflow singleton
model WorkflowState {
  id          String    @id
  enabled     Boolean
  lastRunAt   DateTime?
  lastSuccess Boolean?
  lastError   String?
  runCount    Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

/// P1 (2026-09-11) — kullanıcı çalışma alanı tercihleri: hesap bazlı
/// (`userId` + `tenantId`), tema/font/yoğunluk/sidebar/nav-sırası/son-rota.
/// Audit/finans/yetki verisinden AYRI tablo. BU MİGRATION HİÇBİR
/// VERİTABANINA UYGULANMADI — yalnızca dosya olarak eklendi.
model UserPreference {
  userId           String
  tenantId         String
  themeProfile     String?
  fontChoice       String?
  density          String?
  sidebarCollapsed Boolean?
  navOrderJson     String?   @db.Text
  /// C — Günlük Özet kişisel ayarları (varsayılan şube, gizlenen bölümler).
  /// JSON string; şema `DashboardPreferences` (src/lib/user-preferences.ts).
  dashboardJson    String?   @db.Text
  lastRoute        String?
  updatedAt        DateTime  @updatedAt

  @@id([userId, tenantId])
  @@index([tenantId])
}

/// General-purpose critical-action audit trail (EPIC 0). Distinct from
/// `AiAuditLog` (AI capability invocations only) — this covers human-triggered
/// writes: payments, tahsilat messages, teacher fee changes, makeup decisions,
/// student data writes, and (as those epics land) gelişim raporu/dosya/duyuru/
/// ders start-end corrections. No `@relation` to `Tenant` — same rationale as
/// `AiAuditLog`: the trail must stay queryable even if the tenant row is later
/// removed. `meta` never carries raw personal content, only shape/amount/status.
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String
  actorRole   String
  action      String
  entityType  String
  entityId    String
  outcome     String
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, action, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([createdAt])
}

/// One execution of an autonomous workflow (history)
model WorkflowRun {
  id         String   @id
  workflowId String
  tenantId   String
  startedAt  DateTime
  finishedAt DateTime
  durationMs Int
  success    Boolean
  steps      Json
  error      String?

  @@index([workflowId, tenantId, startedAt])
  @@index([tenantId, startedAt])
}

/// Öğrenci müfredat/konu ilerleme — öğretmen hedef konu tanımlar;
/// progressPercent 0–100; genel ilerleme konuların ortalaması.
model StudentCurriculumTopic {
  id              String   @id
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId       String
  teacherId       String
  title           String
  description     String?
  /// planned | in_progress | mastered | deferred
  status          String   @default("planned")
  progressPercent Int      @default(0)
  sortOrder       Int      @default(0)
  notes           String?  @db.Text
  /// CurriculumTopicEvent[] — güncelleme geçmişi
  history         Json
  createdBy       String
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, teacherId])
}

/// PRODUCT_BACKLOG §1.4

model AiAuditLog {
  id             String    @id
  tenantId       String
  capabilityId   String
  callerRole     String
  chosenProvider String
  usedFallback   Boolean   @default(false)
  success        Boolean
  errorMessage   String?
  durationMs     Int
  approvalStatus String    @default("not_required")
  approvedAt     DateTime?
  approvedBy     String?
  createdAt      DateTime  @default(now())

  @@index([tenantId, capabilityId])
  @@index([tenantId, approvalStatus])
}

model SocialMediaConsent {
  id                 String    @id
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId          String
  status             String
  representativeName String
  relationship       String
  grantedAt          DateTime
  scopes             Json
  sourceDocumentRef  String?
  withdrawnAt        DateTime?
  history            Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, studentId])
}

/// Faz 8 (KVKK) — hukuki metnin VERSİYONLU geçmişi. `DocumentTemplate`'in
/// "in-place mutate + version++" deseninin AKSİNE, buradaki her düzenleme
/// YENİ bir satır ekler (mevcut satırlar ASLA güncellenmez) — bir kullanıcının
/// tam olarak HANGİ metne onay verdiğini ispatlayabilmek KVKK'nın kendisi
/// için zorunlu; metin sonradan değişse bile eski onayın referans aldığı
/// metin kaybolmaz.
model ConsentTextVersion {
  id            String   @id
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consentType   String
  version       Int
  bodyText      String
  effectiveFrom DateTime
  createdBy     String
  createdAt     DateTime @default(now())

  @@unique([tenantId, consentType, version])
  @@index([tenantId, consentType, effectiveFrom])
}

/// Faz 8 (KVKK) — `SocialMediaConsent` ile AYNI iskelet (append-only tarihçe,
/// grant/withdraw). ip/device alanları BİLİNÇLİ OLARAK ayrı, opsiyonel bir
/// Json alt-küme (`deviceInfo`) — yalnızca tenant `consentSettings.
/// recordDeviceInfo=true` ise doldurulur (veri minimizasyonu, spec'in kendi
/// isteği).
model KvkkConsent {
  id               String    @id
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "student" | "parent" | "user"
  subjectType      String
  subjectId        String
  consentType      String
  textVersionId    String
  acceptedAt       DateTime
  /// "portal" | "form" | "admin" vb. — hangi kanaldan onay alındığı.
  channel          String
  withdrawnAt      DateTime?
  withdrawalReason String?
  /// Yalnızca consentSettings.recordDeviceInfo=true iken dolu: { ip?, userAgent? }.
  deviceInfo       Json?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, consentType])
}

/// Faz 11 — CRM arama günlüğü (sağlayıcıdan bağımsız; gerçek telefoni
/// entegrasyonu YOK, bu turda manuel giriş + webhook-idempotency iskeleti).
model CallLog {
  id               String    @id
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  callerNumber     String
  callerName       String?
  /// "student" | "parent" | "lead"
  contactType      String?
  contactId        String?
  /// "inbound" | "outbound"
  direction        String
  answered         Boolean
  durationSeconds  Int?
  occurredAt       DateTime
  callbackDone     Boolean   @default(false)
  callbackAt       DateTime?
  callbackByUserId String?
  note             String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, occurredAt])
  @@index([tenantId, contactType, contactId])
}

/// Faz 11 — CRM mesaj günlüğü. `contentOrSummary` ham içeriği taşır;
/// erişim sınırlaması uygulama katmanında (liste vs detay) yapılır.
model MessageLog {
  id               String   @id
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "sms" | "whatsapp" | "email" | "other"
  channel          String
  senderIdentifier String
  occurredAt       DateTime
  contentOrSummary String
  /// "unread" | "read" | "replied"
  status           String   @default("unread")
  contactType      String?
  contactId        String?
  responderUserId  String?
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, occurredAt])
  @@index([tenantId, contactType, contactId])
}

/// Faz 11 — iletişim sağlayıcı webhook idempotency (SmsInboundEvent ile AYNI desen).
model CommunicationInboundEvent {
  id                String   @id
  providerMessageId String
  kind              String
  tenantId          String?
  processedAt       DateTime @default(now())

  @@unique([providerMessageId, kind])
  @@index([tenantId])
}

/// PRODUCT_BACKLOG §4.2
/// PRODUCT_BACKLOG §4.2 + ÖNCELİK 4 — yönetici özel kapalı gün VEYA (isOpen:true
/// ile) normalde kapalı bir günü (dönem haftalık kuralı/resmi tatil) zorla AÇIK
/// yapan tek satırlık istisna. Tarih başına tek kayıt (upsert) — tekrar set
/// etmek yeni satır değil güncelleme yapar. Kurum çapında (öğrenciye özel değil).
model ClosedDay {
  id        String   @id
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      String
  name      String
  kind      String
  /// false (varsayılan) = bu tarihi KAPALI yapar; true = normalde kapalı
  /// olabilecek bu tarihi (dönem kuralı/resmi tatil) zorla AÇIK yapar.
  isOpen    Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId])
}

/// ÖNCELİK 4 (devam) — Yönetilebilir Enstrüman Kataloğu. Additive: mevcut
/// sabit `Instrument` TS enum'unun (src/lib/types.ts INSTRUMENTS) yerini
/// ALMAZ — o tip hâlâ Piyano/Yan Flüt/Gitar/Bateri/Keman/Şan için TypeScript
/// güvenliği sağlar. Bu tablo, kurumun o sabit kümenin ÜSTÜNE ekleyebileceği
/// ek enstrümanları (ör. Bas Gitar, Ukulele) yönetir — server-side doğrulama
/// hem statik enum'u HEM bu tabloyu (aktif kayıtlar) birlikte kabul eder.
/// Hard delete YOK — `status` ile pasife alınır. Aynı tenant içinde harf
/// büyüklüğünden bağımsız yinelenen isim engellenir (bkz.
/// src/lib/instrument-catalog.ts createInstrumentCatalogEntry).
model InstrumentCatalogEntry {
  id        String   @id
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// "active" | "archived"
  status    String   @default("active")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

/// Personel Modülü — öğretmen DIŞI personel (idari, muhasebe, resepsiyon
/// vb.). Teacher'dan bilinçli olarak AYRI (bkz. src/lib/types.ts
/// StaffMember yorumu) — ileride bir muhasebe modülü bu id'yi FK olarak
/// referans alabilir. Hard delete YOK: `status:"passive"` ile pasife alınır.
/// İş 3 — tam özlük dosyası + maaş yapısı alanları. Öğretmen (Teacher)
/// modeliyle BİLİNÇLİ olarak birleştirilmez (bkz. PayrollRecord yorumu).
model StaffMember {
  id                       String    @id
  tenantId                 String
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Faz 12 — insan-okunur, değişmez kurum numarası (ör. "P00001").
  displayId                String?
  name                     String
  position                 String
  phone                    String?
  email                    String?
  address                  String?
  /// P0 personel onboarding revizyonu (2026-09-11) — il/ilçe, nullable/
  /// additive: mevcut satırlar backfill GEREKTİRMEZ, NULL "belirtilmemiş"
  /// okunur. BU MİGRATION HİÇBİR VERİTABANINA UYGULANMADI.
  city                     String?
  district                 String?
  birthDate                DateTime?
  photoUrl                 String?
  /// AES-GCM şifreli — bkz. src/lib/pii/tc-identity.ts, Student.nationalIdCipher ile AYNI mekanizma.
  nationalIdCipher         String?
  nationalIdLast2          String?
  employeeNumber           String?
  hireDate                 DateTime?
  terminationDate          DateTime?
  department               String?
  reportsToStaffId         String?
  /// "full_time" | "part_time" | "contract" | "intern"
  employmentType           String?
  branchId                 String?
  /// "active" | "on_leave" | "passive" | "terminated"
  status                   String    @default("active")
  annualLeaveAllowanceDays Int?
  /// Yalnız admin/super admin görünürlüğü — bkz. canViewStaffSensitive.
  personnelNotes           String?
  notes                    String?
  /// Maaş yapısı — bordro oluşturulurken varsayılan önerilir, öğretmen hakedişinden AYRI.
  monthlySalary            Int?
  hourlyRate               Int?
  defaultBonus             Int?
  defaultAllowances        Int?
  defaultDeductions        Int?
  /// Faz 9A — özlük genişletmesi.
  emergencyContactName     String?
  /// P0 personel onboarding revizyonu (2026-09-11) — yakınlık derecesi,
  /// nullable/additive. BU MİGRATION HİÇBİR VERİTABANINA UYGULANMADI.
  emergencyContactRelationship String?
  emergencyContactPhone    String?
  /// P0 personel onboarding revizyonu (2026-09-11) — portal bağlantısı:
  /// bağlı SCHOOL_ADMIN User satırı + son davet zamanı, nullable/additive.
  /// Rol ayrı kolonda DEĞİL — tek gerçek kaynak User.role. BU MİGRATION
  /// HİÇBİR VERİTABANINA UYGULANMADI.
  portalUserId             String?
  portalInvitedAt          DateTime?
  contractStartDate        DateTime?
  contractEndDate          DateTime?
  sgkStatus                String?
  /// AES-GCM şifreli — bkz. src/lib/pii/iban.ts, nationalIdCipher ile AYNI mekanizma.
  ibanCipher               String?
  ibanLast4                String?
  /// Faz 9B — yıllık avans üst sınırı. Tanımsızsa kontrol edilmez.
  annualAdvanceLimit       Int?
  createdBy                String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  advances StaffAdvance[]

  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([tenantId, status])
}

/// Faz 9B — personel maaş avansı talebi. leave.ts'in durum-geçiş deseniyle
/// AYNI (pending_approval -> approved|rejected -> paid|cancelled), ayrıca
/// StaffMember.annualAdvanceLimit karşısında yıl içi kullanım toplamıyla
/// sınırlandırılır (bkz. src/lib/staff-advance.ts).
model StaffAdvance {
  id            String      @id
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId       String
  staffMember   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  amount        Int
  requestDate   DateTime
  /// "pending_approval" | "approved" | "rejected" | "paid" | "cancelled"
  status        String      @default("pending_approval")
  approvedBy    String?
  approvedAt    DateTime?
  paidAt        DateTime?
  paymentMethod String?
  description   String?
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId, staffId])
  @@index([tenantId, status])
}

/// İş 3B — StaffMember aylık bordro kaydı. TeacherPayout (ders bazlı öğretmen
/// hakedişi) ile HİÇBİR otomatik bağlantısı yok — bilinçli ayrım.
model PayrollRecord {
  id            String    @id
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId       String
  /// yyyy-MM
  month         String
  grossAmount   Int
  netAmount     Int
  extraPayment  Int?
  deduction     Int?
  /// "draft" | "pending_approval" | "approved" | "paid" | "cancelled"
  status        String    @default("draft")
  paymentDate   DateTime?
  paymentMethod String?
  note          String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, staffId, month])
  @@index([tenantId])
  @@index([tenantId, staffId, month])
}

/// İş 3C — personel izin talebi. Yasal/otomatik bakiye hesaplama motoru
/// DEĞİL — bkz. StaffMember.annualLeaveAllowanceDays yorumu.
model LeaveRequest {
  id          String    @id
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId     String
  /// "annual" | "sick" | "unpaid" | "other"
  type        String
  startDate   DateTime
  endDate     DateTime
  dayCount    Int
  description String?
  /// "draft" | "pending_approval" | "approved" | "rejected"
  status      String    @default("pending_approval")
  approvedBy  String?
  approvedAt  DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, staffId])
}

/// İş 3D — kurum sahibi mali dashboard'u için, ÖNCEDEN hiçbir yerde
/// izlenmeyen gider türleri (bkz. src/lib/expense.ts modül yorumu).
model ExpenseRecord {
  id              String    @id
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "rent" | "utilities" | "supplies" | "other"
  category        String
  amount          Int
  date            DateTime
  note            String?
  createdBy       String
  createdAt       DateTime  @default(now())
  /// Faz 10 — genişletme (hepsi additive/nullable).
  subcategory     String?
  supplier        String?
  branchId        String?
  currency        String    @default("TRY")
  taxAmount       Int?
  dueDate         DateTime?
  /// "pending" | "paid" | "overdue" — tanımsızsa "paid" sayılır (eski kayıtlar).
  paymentStatus   String?
  paymentMethod   String?
  /// "pending" | "approved" | "rejected"
  approvalStatus  String?
  approvedBy      String?
  recurringRuleId String?

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, branchId])
}

/// Faz 10 — periyodik olarak otomatik ExpenseRecord üreten kural.
model RecurringExpenseRule {
  id          String   @id
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String
  subcategory String?
  supplier    String?
  branchId    String?
  amount      Int
  /// "monthly" | "quarterly" | "yearly"
  frequency   String
  nextRunDate DateTime
  note        String?
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, active, nextRunDate])
}

/// Faz 10 — kategori/şube/dönem bazlı hedef gider tutarı.
model Budget {
  id           String   @id
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     String
  branchId     String?
  /// yyyy-MM
  period       String
  targetAmount Int
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, category, branchId, period])
  @@index([tenantId, period])
}

/// ÖNCELİK 4 (devam) — Paket Yönetimi. Additive/yeni: mevcut serbest metin
/// `Student.packageName` alanının yerini almaz, üstüne eklenir (bkz.
/// Student.packageId, opsiyonel FK). Fiyatlar KURUŞ/TL tam sayı (Payment.amount
/// ile aynı kural — asla float) — 30/40/50 dk ders süresi başına ayrı fiyat.
/// Hard delete YOK: `status` ile pasife alınır/arşivlenir; geçmiş
/// Payment/tahsilat kayıtları paket fiyatı sonradan değişse bile ETKİLENMEZ
/// (Payment.amount oluşturma anında donmuş bir değerdir, Package'a canlı
/// referans vermez — bkz. lesson-ops.ts computeLessonChargeAmount, bu paket
/// fiyatını DEĞİL öğrencinin kendi monthlyFee'sini kullanır; paket fiyatı
/// yalnızca YENİ öğrenci kaydında/ileriye dönük referans amaçlıdır).
model Package {
  id                     String    @id
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Paket & Kampanya Motoru — kurum bazında okunabilir numara (ör. "PKT-001").
  /// NULL = motor öncesi eski kayıt (backfill YOK, onaysız dokunulmaz).
  displayId              String?
  title                  String
  description            String?
  /// Çoklu şube kapsamı (string[] JSON) — boş/NULL = tüm şubeler.
  applicableBranchIds    Json?
  /// "active" | "archived" — pasif/arşivlenmiş paket yeni öğrenci kaydında seçilemez.
  status                 String    @default("active")
  /// TL, tam sayı (kuruş hassasiyeti gerekmiyor — mevcut Payment.amount ile aynı kural).
  price30Min             Int
  price40Min             Int
  price50Min             Int
  /// "guz" | "yaz" | null (Genel — her iki dönemde de geçerli).
  termLabel              String?
  /// Aylık (bireysel) ders adedi.
  monthlyLessonCount     Int?
  /// Grup solfej / ek ders adedi (aylık).
  groupLessonCount       Int?
  /// Öğrenci kaydında önerilen varsayılan ders süresi (30/40/50).
  defaultDurationMinutes Int?
  /// Öğrenci kaydında önerilen varsayılan ödeme günü (1–28).
  defaultPaymentDueDay   Int?
  /// Paket kapsamını açıklayan serbest metin not.
  notes                  String?   @db.Text
  createdBy              String
  /// Oluşturan kullanıcı (User.id). Eski kayıtlarda NULL.
  createdByUserId        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  students               Student[]

  /// displayId tenant-kapsamlı benzersizdir (farklı kurumlar aynı numarayı kullanabilir).
  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([tenantId, status])
}

/// Paket 5 — yüzde tabanlı kampanya/indirim kural motoru (ör. "Kardeş Kampanyası").
/// Package ile aynı desen: Tenant çapında, School'a bağlı değil.
model DiscountCampaign {
  id              String    @id
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Paket & Kampanya Motoru — kurum bazında okunabilir numara (ör. "KMP-001").
  /// NULL = motor öncesi eski kayıt (backfill YOK, onaysız dokunulmaz).
  displayId       String?
  name            String
  description     String?   @db.Text
  /// "sibling" — ilk ve tek tanımlı tür; ileride yeni türlere genişleyebilir.
  kind            String
  discountPercent Int
  active          Boolean   @default(true)
  validFrom       DateTime?
  validTo         DateTime?
  /// Verilmezse tüm şubelerde geçerli.
  branchId        String?
  /// Çoklu şube kapsamı (string[] JSON) — boş/NULL = tüm şubeler.
  applicableBranchIds Json?
  /// "none" | "additive" | "override" | "yield" (bkz. CampaignStackingRule).
  stackingRule    String    @default("none")
  priority        Int       @default(0)
  /// NULL = sınırsız; dolunca kapanmaz, yalnız uyarı üretilir (soft).
  maxUsageCount   Int?
  usageCount      Int       @default(0)
  /// İleride genişletilebilir kural alanı.
  conditions      Json?
  createdBy       String
  /// Oluşturan kullanıcı (User.id). Eski kayıtlarda NULL.
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// 2026-09-29 — "Sil" = soft delete (kritik şifre + gerekçe). Dolu = yeni kayıtta seçilemez,
  /// düzenlenemez; geçmiş öğrenci fiyatı/rapor aynen kalır. NULL = silinmemiş.
  deletedAt       DateTime?
  deletedByUserId String?
  deletionReason  String?

  /// displayId tenant-kapsamlı benzersizdir (farklı kurumlar aynı numarayı kullanabilir).
  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([tenantId, active])
}

/// PRODUCT_BACKLOG §5
model TrialLesson {
  id                 String   @id
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  phone              String
  /// 2026-09-30 — veli adı (opsiyonel; öğrenciye dönüşümde ön doldurulur).
  parentName         String?
  instrument         String
  branchId           String
  teacherId          String
  startAt            DateTime
  endAt              DateTime
  durationMinutes    Int
  status             String   @default("planned")
  convertedStudentId String?
  /// Deneme → öğrenci dönüşümünü yapan kullanıcı ve anı (dönüşüm raporu/performans).
  convertedAt        DateTime?
  convertedByUserId  String?
  /// Hazırlık notu — ders öncesi/planlama sırasında (ders sonrası nottan AYRI).
  notes              String?
  /// Ders sonrası sonuç/görüşme notu — hazırlık notunun üzerine yazılmaz.
  resultNotes        String?
  resultNotesAt      DateTime?
  resultNotesByUserId String?
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, teacherId])
}

/// 2026-10-05 — Herkese açık deneme dersi başvurusu (/basvuru/[kurum]/deneme). Rezervasyon DEĞİL, tercihtir:
/// yönetici arayıp Deneme Dersleri > Başvurular'dan planlar (planlama mevcut çakışma kurallarıyla doğrulanır).
model TrialApplication {
  id               String    @id
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "BD-000123" — kuruma özgü, insan-okunur başvuru no.
  applicationNo    String
  name             String
  phone            String
  email            String?
  parentName       String?
  age              Int?
  instrument       String
  /// 2026-10-06 — seçilen tüm enstrümanlar (JSON dizi). Boş = eski kayıt, yalnız `instrument`.
  instruments      Json?
  /// Tercih edilen şube (boş = fark etmez).
  branchId         String?
  /// Adayın tercih ettiği zamanlar: [{ startAt, branchId?, teacherId? }]. 2026-10-06'dan beri aday yazar (1–5);
  /// eski kayıtlarda sistem önerisi (en fazla 3, teacherId'li).
  preferredSlots   Json?
  /// Serbest uygunluk notu ("hafta içi 17:00 sonrası").
  availabilityNote String?
  note             String?
  kvkkConsentAt    DateTime
  /// "new" | "contacted" | "planned" | "declined"
  status           String    @default("new")
  staffNote        String?
  trialLessonId    String?
  handledByUserId  String?
  handledAt        DateTime?
  source           String?
  createdAt        DateTime  @default(now())

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// 2026-10-05 — KULÜP (grup dersi mantığı): örn. "Solfej Kulübü". Ücret AYLIK sabittir ve sözleşmeye girmez.
/// Oturumlar (2. aşama) ders programına üye başına ders satırı olarak yazılır; oda kapasitesi aranmaz.
model Club {
  id              String           @id
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  instrument      String
  /// Kulübün şubesi (boş = şube bağımsız).
  branchId        String?
  maxMembers      Int              @default(10)
  /// Üye başına aylık ücret (TL). Üyelik, katıldığı andaki ücreti dondurur.
  monthlyFee      Int
  /// Oturum süresi (dk) — hakediş mevcut süre kuralıyla.
  durationMinutes Int
  /// Kulüp derslerini veren öğretmenler: string[].
  teacherIds      Json
  description     String?
  active          Boolean          @default(true)
  /// 2026-10-06 — yanlışlıkla oluşturulan kulübü silme = gizleme (kritik şifre + gerekçe); kayıt ve ücret izi kalır.
  deletedAt       DateTime?
  deletedByUserId String?
  deletionReason  String?
  /// 2026-10-07 — Grup dersi başvuru portalı. Hepsi eklemeli; mevcut kulüpler başvuruya KAPALI kalır.
  /// "child" | "youth" (Genç, 2026-10-07) | "adult" (boş = belirtilmemiş; başvuruya açmak için zorunlu). Serbest metin
  /// kolon: geçerli değerler uygulama katmanında (clubs.ts CLUB_AUDIENCES) doğrulanır — DB enum/kısıt yok.
  audience              String?
  minAge                Int?
  maxAge                Int?
  /// YYYY-MM-DD — kulüp döneminin başlangıcı / bitişi (başvuruya açmak için zorunlu; bitmiş dönem başvuru almaz).
  startDate             String?
  endDate               String?
  /// Halka açık gün/saat metni (ör. "Cumartesi 10:00–11:00").
  scheduleText          String?
  /// "monthly" | "term" | "total" — `monthlyFee` alanındaki tutarın niteliği. Aylık tahakkuk yalnız "monthly".
  feePeriod             String           @default("monthly")
  /// 2026-10-07 — "Ödeme alınacak ay sayısı" (yalnız aylık): üyeliğin başlangıç ayı 1. ay; sonrası tahakkuk etmez.
  /// NULL = üyelik sonlanana kadar her ay (önceki davranış). Yazılmış ücret satırlarını DEĞİŞTİRMEZ.
  feeMonths             Int?
  /// 2026-10-07 — Başvuranlara gösterilen "Toplam ders sayısı" (yönetici girer; NULL = belirtilmemiş, 0 gösterilmez).
  totalLessons          Int?
  /// Halka açık "pakete dahil olanlar" metni.
  includesText          String?
  /// Yalnız panelde görünen yönetim notu (halka açık yanıta ASLA girmez).
  internalNote          String?
  applicationsOpen      Boolean          @default(false)
  /// Dolu kulüp başvuru alır mı (bekleme listesi). false = dolu kulüp başvuruya kapanır.
  waitlistEnabled       Boolean          @default(false)
  /// Ana kulübe dahil (ek ücretsiz) solfej kulübü — aynı kurumun kulübü.
  includedSolfegeClubId String?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     ClubMembership[]

  @@index([tenantId, active])
}

/// Öğrencinin kulüp üyeliği. Silinmez; ayrılınca `endDate` dolar (geçmiş ve tahsilat izi kalır).
model ClubMembership {
  id              String    @id
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  studentId       String
  /// Katılma anındaki aylık ücret (kulüp ücreti sonradan değişse de bu üyelik bunu öder).
  monthlyFee      Int
  /// YYYY-MM-DD — ilk ücretli ay bu tarihin ayı.
  startDate       String
  /// YYYY-MM-DD — SONLANMA günü (2026-10-07): bu günden itibaren aktif değildir (clubs.ts isMembershipActive).
  /// Sonlanma ayı, ayın 1'i değilse son ücretli aydır; boş = devam ediyor.
  endDate         String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  endedByUserId   String?
  endedAt         DateTime?
  /// 2026-10-07 — üyeliği açan grup dersi başvurusu (varsa).
  applicationId   String?
  /// Dahil solfej üyeliğinde: bu hakkı veren ANA üyelik kimlikleri (string[]). Boş/null = bağımsız üyelik.
  includedByMembershipIds Json?

  @@index([tenantId, clubId])
  @@index([tenantId, studentId])
}

/// 2026-10-07 — Herkese açık grup dersi (kulüp) başvurusu. Başvuru kesin kayıt değildir; ücret/borç/üyelik
/// oluşturmaz. `clubSnapshot` başvuru anındaki halka açık kulüp/ücret bilgisidir (sonradan değişse de saklanır).
model ClubApplication {
  id                  String    @id
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Adaya gösterilen rastgele referans (sıra numarası değil — başvuru hacmini ifşa etmez).
  reference           String
  clubId              String
  branchId            String?
  /// new | contacted | waitlisted | added | declined | withdrawn
  status              String    @default("new")
  /// Kulüp doluyken bekleme listesine yapılan başvuru.
  waitlistRequested   Boolean   @default(false)
  participantName     String
  /// YYYY-MM-DD (isteğe bağlı; yaş uygunluğu için).
  birthDate           String?
  age                 Int?
  /// İletişim telefonu (çocuk grubunda veli telefonu).
  phone               String
  email               String?
  parentName          String?
  note                String?
  kvkkConsentAt       DateTime
  kvkkTextVersionId   String?
  clubSnapshot        Json
  studentId           String?
  membershipId        String?
  solfegeMembershipId String?
  /// Dahil solfej dolu olduğu için yöneticinin onayıyla bekleyen hak.
  solfegePending      Boolean   @default(false)
  staffNote           String?
  handledByUserId     String?
  handledAt           DateTime?
  source              String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, clubId])
  @@index([tenantId, status])
  @@index([tenantId, phone])
}

/// PRODUCT_BACKLOG §6 Faz 1
model DocumentTemplate {
  id                 String    @id
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind               String
  name               String
  bodyHtml           String
  active             Boolean   @default(true)
  /// Şablonu oluşturan yönetici — varsayılan (otomatik seed) şablonlarda null.
  createdById        String?
  /// Her düzenlemede +1 — "versiyon/oluşturma bilgisi" gereksinimi (Evraklar Faz 2).
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// P0 (2026-08-30, DOCX-öncelikli şablon iş akışı) — admin'in yüklediği ORİJİNAL
  /// .docx dosyası base64 olarak burada saklanır, yetkili admin'e AYNEN indirilebilir.
  /// `bodyHtml` mammoth ile üretilen bir HTML önizlemesidir, DOCX'in kayıpsız
  /// karşılığı DEĞİLDİR. Yalnızca DOCX'ten yüklenen şablonlarda dolu olur.
  sourceFileData     String?
  sourceFileName     String?
  sourceMimeType     String?
  sourceUploadedAt   DateTime?
  sourceUploadedById String?

  @@index([tenantId, kind])
}

model DocumentInstance {
  id               String    @id
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId       String
  kind             String
  reference        String
  /// "issued" (üretildi/arşivde kalıcı) | printed | sent_for_signature | signed |
  /// uploaded | cancelled | expired. "draft" LEGACY'dir — 20260920120000
  /// migration'ı mevcut satırları "issued"a taşıdı; yeni kayıtlarda yazılmaz.
  status           String    @default("issued")
  studentId        String?
  teacherId        String?
  trialLessonId    String?
  branchId         String?
  fieldValues      Json
  renderedHtml     String?
  printCount       Int       @default(0)
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  fileName         String?
  fileMimeType     String?
  fileData         String?
  fileSize         Int?
  signedUploadedAt DateTime?
  /// İmzalı sürümü yükleyen sorumlu (kural E).
  signedBy         String?
  /// Append-only imzalı sürüm YÜKLEME geçmişi (metadata) — bkz.
  /// src/lib/documents/index.ts uploadSignedDocumentFile/softDeleteSignedVersion.
  signedVersions   Json?

  @@unique([tenantId, reference])
  @@index([tenantId, studentId])
  @@index([tenantId, kind])
}

/// FEATURE A (versioned öğrenci kayıt sözleşmesi + ödeme planı) — additive.
/// Gerçek PDF üretimi/yazdırma/ıslak-imza-tarama-yükleme MEVCUT
/// DocumentTemplate/DocumentInstance altyapısını (bkz. yukarı) TEKRARLAMAZ —
/// her sözleşme versiyonu tam olarak BİR `DocumentInstance` (kind=
/// "student_enrollment_contract") ile 1:1 eşleşir; o satırın `reference`'ı
/// aynı zamanda bu satırın `contractNumber`'ıdır (tek üretici: documents/
/// index.ts createDocumentInstance → buildDocumentReference). Bu model
/// yalnızca sözleşmeye özgü versiyon zinciri + ödeme planı alanlarını tutar.
/// Taksitler AYRI bir model DEĞİL — mevcut `Payment` satırlarına
/// `contractId`/`installmentSequence` ile bağlanır (kural: mevcut tahsilat/
/// makbuz/hatırlatma/gecikme motorları taksitler için OTOMATİK çalışır).
model StudentContract {
  id                    String            @id
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId             String
  student               Student           @relation(fields: [studentId], references: [id])
  /// = documentInstance.reference (bkz. yukarıdaki not) — ayrıca burada
  /// tutulur ki liste/arama ekranları DocumentInstance'a join YAPMADAN
  /// çalışabilsin.
  contractNumber        String
  versionNumber         Int
  /// "initial" | "renewal" | "amendment"
  contractType          String
  previousContractId    String?
  /// 2026-10-04 — sözleşmenin ait olduğu eğitim (Student.enrollments[].id); NULL = birincil/eski eğitim.
  enrollmentId          String?
  previousContract      StudentContract?  @relation("ContractVersionChain", fields: [previousContractId], references: [id])
  nextVersions          StudentContract[] @relation("ContractVersionChain")
  /// Bu sözleşmenin PDF render/yazdırma/imzalı-tarama-yükleme'sini yürüten
  /// DocumentInstance satırı — CRUD BURADA DEĞİL, src/lib/documents/index.ts
  /// mevcut fonksiyonlarında (createDocumentInstance/markDocumentPrinted/
  /// uploadSignedDocumentFile) yürütülür. 1-2 aylık "tanışma" kayıtlarında
  /// (durationMonths < 3) NULL — resmi sözleşme/PDF üretilmez (kural: trial
  /// paketler için formal sözleşme belgesi ZORUNLU DEĞİL).
  documentInstanceId    String?           @unique
  /// createDocumentInstance çağrıldığı andaki DocumentTemplate.version —
  /// şablon SONRADAN değişse/versiyonu artsa bile bu sözleşmenin HANGİ
  /// metne dayandığı kalıcı olarak bellidir. Trial kayıtlarda NULL.
  templateVersion       Int?
  /// "draft" | "generated" | "printed" | "wet_signature_pending" | "signed"
  /// | "superseded" | "cancelled" | "recorded" — bkz. src/lib/contracts.ts
  /// CONTRACT_STATUSES. "recorded" = 1-2 aylık trial kaydı, formal belge YOK,
  /// yazdırma/imza adımları geçerli değil. DocumentInstance.status (draft/
  /// printed/uploaded/...) İLE AYNI ALAN DEĞİLDİR — o belge-dosyası yaşam
  /// döngüsü, bu SÖZLEŞME iş süreci yaşam döngüsüdür (kural 13:
  /// aktivasyon/imza durumları ayrı kalmalı).
  status                String            @default("generated")
  /// Üretim anındaki TÜM alanların DEĞİŞMEZ anlık görüntüsü (program, veli/
  /// imzalayan bilgisi, tarihler, tutar, taksit listesi) — Student satırı
  /// sonradan değişse bile bu sözleşmenin GERÇEKTEN neyi vaat ettiği
  /// kaybolmaz (kural 3 — immutable data snapshot).
  contractDataSnapshot  Json
  programmeName         String
  enrollmentStartDate   DateTime
  enrollmentEndDate     DateTime
  durationMonths        Int
  monthlyAmount         Int
  installmentCount      Int
  totalContractAmount   Int
  depositAmount         Int?
  paymentMethod         String?
  signatoryFullName     String
  signatoryNationalId   String?
  signatoryAddress      String?
  /// "veli" | "öğrenci" (18 yaş+ kendisi imzalıyorsa)
  signatoryRelationship String?
  installments          Payment[]
  createdBy             String
  generatedBy           String
  printedBy             String?
  printedAt             DateTime?
  signedAt              DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([tenantId, contractNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([previousContractId])
}

/// İş Takip modülü (insan-odaklı operasyon görev takibi — /panel/is-takip,
/// /ogretmen/is-takip). /panel/workflows (AI otomasyonu) ile İLGİSİZ, ayrı
/// bir modül. Bağlı kayıtlar (studentId/teacherId/branchId/lessonId/
/// paymentId/documentId) yalnızca ID olarak tutulur — FK/relation YOK,
/// silme/tenant-taşıma ile ilgili kısıtlama zinciri oluşturmasın diye;
/// aynı-tenant doğrulaması uygulama katmanında (src/lib/tasks.ts) yapılır.
model Task {
  id                 String    @id
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title              String
  description        String?   @db.Text
  /// TODO | IN_PROGRESS | BLOCKED | COMPLETED | CANCELLED | ARCHIVED
  status             String    @default("TODO")
  /// LOW | MEDIUM | HIGH | URGENT
  priority           String    @default("MEDIUM")
  /// Kayıt | Eğitim | Tahsilat | Veli İletişimi | Öğretmen | Program | Evrak | Teknik
  category           String
  assigneeId         String?
  followerIds        Json      @default("[]")
  createdById        String
  startDate          DateTime?
  dueDate            DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  archivedAt         DateTime?
  /// 9. tur — geri alınabilir silme (kritik işlem şifresiyle). Dolu = listelerde/raporlarda yok.
  deletedAt          DateTime?
  deletedByUserId    String?
  deletionReason     String?
  progressPercent    Int       @default(0)
  tags               Json      @default("[]")
  studentId          String?
  teacherId          String?
  branchId           String?
  lessonId           String?
  paymentId          String?
  documentId         String?
  /// Genel ilişkili-kayıt bağlantısı (student|teacher|payment|document|makeup|lessonCorrection|branch) —
  /// yukarıdaki özel FK alanlarına (studentId vb.) EK olarak, onlar karşılamadığında (telafi/ders düzeltme) kullanılır.
  relatedEntityType  String?
  relatedEntityId    String?
  /// Oluşturma anında alınmış, denormalize görüntü etiketi (kayıt sonradan değişse/silinse bile bağlam korunur).
  relatedEntityLabel String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  checklistItems TaskChecklistItem[]
  comments       TaskComment[]
  activities     TaskActivity[]
  attachments    TaskAttachment[]

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, dueDate])
  @@index([tenantId, studentId])
  @@index([tenantId, teacherId])
  @@index([tenantId, relatedEntityType, relatedEntityId])
}

model TaskChecklistItem {
  id            String    @id
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenantId      String
  title         String
  isCompleted   Boolean   @default(false)
  sortOrder     Int       @default(0)
  completedAt   DateTime?
  completedById String?
  archivedAt    DateTime?

  @@index([taskId])
  @@index([tenantId])
}

model TaskComment {
  id        String    @id
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenantId  String
  authorId  String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([taskId])
  @@index([tenantId])
}

model TaskActivity {
  id        String   @id
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenantId  String
  actorId   String
  action    String
  summary   String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([tenantId])
}

/// İş Takip Faz 3B-2A — göreve dosya/link eki. `fileData` ASLA public tipe
/// (TaskAttachment) sızmaz — yalnızca sahiplik/tenant kontrolü geçen indirme
/// tool'u (getTaskAttachmentFileTool) okur, tıpkı TeachingMaterial/
/// HomeworkSubmission'daki aynı desende. Task silinince cascade silinir.
model TaskAttachment {
  id           String    @id
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenantId     String
  /// FILE | LINK
  type         String
  title        String
  url          String?   @db.Text
  fileName     String?
  fileMimeType String?
  fileSize     Int?
  fileData     String?
  createdById  String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([taskId])
  @@index([tenantId])
}

/// İş Takip Faz 3A — son tarih hatırlatma tekilleştirme kaydı. `taskId`'ye
/// bilinçli olarak FK YOK (Task ile aynı desende diğer bağlı-kayıt alanları
/// gibi) — bir görev asla silinmediği için pratik risk yok, ama tutarlılık
/// için mevcut deseni koruyoruz. Benzersizlik anahtarı aynı gün aynı
/// görev+sorumlu+tür için birden fazla bildirim üretilmesini DB seviyesinde
/// engeller (idempotency — bkz. src/lib/task-reminder-log.ts).
model TaskReminderLog {
  id             String   @id
  /// MySQL/utf8mb4 altında 5 sütunlu benzersiz index 3072 bayt sınırını aşmasın diye
  /// (191*4 bayt × 5 > 3072) burada ve aşağıdaki 3 alanda açık VARCHAR uzunluğu
  /// verildi — gerçek değerler (bkz. src/lib/utils.ts uid()) zaten çok daha kısa.
  tenantId       String   @db.VarChar(100)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId         String   @db.VarChar(100)
  /// Bildirimin gittiği User.id — sorumlu değişirse yeni bir satır (eski sorumluya tekrar bildirim GİTMEZ, ayrı anahtar).
  assigneeUserId String   @db.VarChar(100)
  /// DUE_SOON | DUE_TODAY | OVERDUE
  kind           String   @db.VarChar(20)
  /// Kurum saat diliminde "yyyy-MM-dd" — OVERDUE için "günde en fazla 1" bunun sayesinde garanti edilir.
  calendarDay    String   @db.VarChar(10)
  createdAt      DateTime @default(now())

  @@unique([tenantId, taskId, assigneeUserId, kind, calendarDay])
  @@index([tenantId, taskId])
}

/// Faz 3C — "ders işlendi ama ödev verilmedi" hatırlatmasının tekilleştirme
/// kaydı. `TaskReminderLog` İLE AYNI desen ama daha basit: bu olay ders
/// başına EN FAZLA BİR KEZ gerçekleşir (günlük tekrar YOK, `calendarDay`
/// gerekmez) — `@@unique([tenantId, lessonId])` tek başına yeterli garanti.
model LessonHomeworkReminderLog {
  id        String   @id
  tenantId  String   @db.VarChar(100)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessonId  String   @db.VarChar(100)
  createdAt DateTime @default(now())

  @@unique([tenantId, lessonId])
}

/// P0-2 — aynı öğrenci/aynı takvim ayı/aynı tenant için "işlenmiş ders"
/// risk bildiriminin İKİNCİ KEZ üretilmesini engelleyen kalıcı kayıt.
/// `LessonHomeworkReminderLog` İLE AYNI desen — bu olay öğrenci başına ay
/// başına EN FAZLA BİR KEZ gerçekleşir, `@@unique([tenantId, studentId,
/// calendarMonth])` tek başına yeterli garanti (bkz. attendance-risk.ts).
model StudentAttendanceRiskLog {
  id                  String   @id
  tenantId            String   @db.VarChar(100)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId           String   @db.VarChar(100)
  calendarMonth       String   @db.VarChar(7)
  threshold           Int
  triggeredAt         DateTime @default(now())
  triggeredByLessonId String   @db.VarChar(100)

  @@unique([tenantId, studentId, calendarMonth])
  @@index([tenantId, studentId])
}

/// İş Takip Faz 3A — kullanıcı bazlı hatırlatma tercihleri. Sorumlu ATAMA
/// bildirimi bu tercihlerden BAĞIMSIZDIR (mevcut davranış, bkz.
/// task-notifications.ts notifyTaskAssigned) — yalnızca DUE_SOON/DUE_TODAY/
/// OVERDUE hatırlatmaları bu tercihlere tabidir.
model TaskReminderPreference {
  id              String   @id
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  dueSoonEnabled  Boolean  @default(true)
  dueTodayEnabled Boolean  @default(true)
  overdueEnabled  Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, userId])
}

/// Öğrenciler ekranı — "Sütunlar / Görünüm yönetimi". Aynı tenant içindeki
/// tüm SCHOOL_ADMIN/SUPER_ADMIN kullanıcıları isim bazlı görünüm kaydedebilir
/// ve birbirinin kaydettiği (ortak) görünümleri seçebilir — bu yüzden
/// paylaşım tenant düzeyinde, kullanıcı düzeyinde DEĞİL. "En son kullanılan
/// görünüm" kişiye özeldir ve BİLİNÇLİ OLARAK burada değil, sidebar sırası/
/// tema tercihi gibi tarayıcı localStorage'ında tutulur (bkz.
/// src/components/student-column-view-manager.tsx) — sunucuya yazma
/// gerektirmeyen, cihaz/oturum bazlı bir tercih.
model StudentListView {
  id              String   @id
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  /// Görünür kolon anahtarlarının sırayla listesi, ör. ["name","branch","teacher"].
  columns         Json
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// NeviiHub — tipli ayar override (platform / plan / tenant / branch / user).
/// Tenant FK yok: platform ve plan kapsamları bir kurum satırına bağlı değildir.
model SettingOverride {
  id        String   @id
  scopeType String
  scopeId   String
  key       String
  value     Json
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scopeType, scopeId, key])
  @@index([scopeType, scopeId])
  @@index([key])
}

/// NeviiHub — kurum bazlı özellik bayrağı override.
model FeatureFlagOverride {
  id        String   @id
  tenantId  String
  flagKey   String
  enabled   Boolean
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, flagKey])
  @@index([tenantId])
}

/// NeviiHub platform denetim izi. Tenant silinse bile kalır (FK yok).
model PlatformAuditEvent {
  id             String   @id
  actorUserId    String
  actorRole      String
  actorTenantId  String
  targetTenantId String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  requestId      String
  outcome        String
  createdAt      DateTime @default(now())

  @@index([targetTenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/// NeviiHub entegrasyon bağlantı durumu. Secret düz metin tutulmaz.
model IntegrationConnection {
  id             String    @id
  scopeType      String
  scopeId        String
  provider       String
  kind           String
  status         String
  lastVerifiedAt DateTime?
  secretLast4    String?
  secretStored   Boolean   @default(false)
  config         Json
  updatedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([scopeType, scopeId, provider])
  @@index([scopeType, scopeId])
}

/// Kurum sahibi daveti. Ham token saklanmaz — yalnız SHA-256 hash.
model OwnerInvitation {
  id        String    @id
  tenantId  String
  email     String
  name      String
  phone     String?
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdBy String
  /// NeviiOS: null → kurum sahibi (SUPER_ADMIN). HYPER_ADMIN asla davet edilemez.
  role      String?
  /// NeviiOS: BRANCH_MANAGER daveti için şube id listesi.
  branchIds Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, createdAt])
  @@index([email])
}

/// Tenant provisioning denemesi (idempotent tekrar deneme için).
model ProvisioningRun {
  id          String   @id
  tenantId    String
  status      String
  steps       Json
  error       String?
  actorUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
}

/// NeviiOS — kullanıcı ↔ şube erişimi (çoklu şube). Aktif satır yoksa şube
/// kapsamı BOŞTUR (fail-closed); kurum geneline asla düşülmez.
model UserBranchAccess {
  id        String    @id
  tenantId  String
  userId    String
  branchId  String
  grantedBy String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([tenantId, userId])
  @@index([tenantId, branchId])
}

/// NeviiOS — süreli, gerekçeli, salt-okur platform destek erişimi.
/// Impersonation değildir; HYPER_ADMIN kimliği korunur, her görüntüleme audit'lenir.
model SupportAccessSession {
  id          String    @id
  tenantId    String
  actorUserId String
  reason      String
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
  endedBy     String?

  @@index([tenantId, startedAt])
  @@index([actorUserId, startedAt])
}

/// NeviiOS — kritik politika sürümü (taslak → yayın → geri al). Satırlar
/// silinmez; geri alma önceki yayınlanmış değeri kopyalayan YENİ sürümdür.
model PolicyVersion {
  id                String    @id
  scopeId           String
  key               String
  version           Int
  status            String
  value             Json
  reason            String
  createdBy         String
  createdAt         DateTime  @default(now())
  publishedBy       String?
  publishedAt       DateTime?
  rollbackOfVersion Int?

  @@unique([scopeId, key, version])
  @@index([scopeId, key, status])
}

/// NeviiOS — kurum özel rolü (yalnız tenant/branch/assigned/own kapsamı).
model TenantCustomRole {
  id         String    @id
  tenantId   String
  key        String
  label      String
  grants     Json
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// NeviiOS — kullanıcıya ek (özel) rol ataması.
model UserRoleAssignment {
  id        String    @id
  tenantId  String
  userId    String
  roleId    String
  createdBy String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([tenantId, userId])
  @@index([roleId])
}


/// NeviiOS tur 3 — oturum kaydı (tekil oturum sonlandırma). Presence süreç
/// içi önbellekte tutulur, en fazla ~5 dk'da bir lastSeenAt'e yazılır.
model UserSession {
  id           String    @id
  userId       String
  tenantId     String
  role         String
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  device       String?
  lastPath     String?
  lastAction   String?

  @@index([userId, revokedAt])
  @@index([tenantId, lastSeenAt])
}

/// NeviiOS tur 3 — release kaydı (ReleaseManifest). Commit ve deployment ayrı kavramdır.
model PlatformRelease {
  id          String   @id
  product     String
  version     String
  environment String
  commitSha   String
  publishedAt DateTime
  manifest    Json
  createdAt   DateTime @default(now())

  @@index([product, environment, publishedAt])
}

/// NeviiOS tur 3 — deployment kaydı (manuel veya ileride imzalı CI/sağlayıcı olayı).
model PlatformDeployment {
  id          String   @id
  product     String
  provider    String
  environment String
  url         String?
  commitSha   String
  branch      String
  status      String
  releaseId   String?
  recordedBy  String
  source      String
  createdAt   DateTime @default(now())

  @@index([product, environment, createdAt])
}
