{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/v1/platform/jobs/retention?apply=1",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/v1/platform/jobs/monthly-accrual?apply=1",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/v1/notifications/tick?stages=lessons",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/v1/notifications/tick",
      "schedule": "0 6 * * *"
    }
  ]
}
